<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://traffic-law-expert-system.local/traffic.owl"
         xmlns="http://traffic-law-expert-system.local/traffic.owl#">

<owl:Ontology rdf:about="http://traffic-law-expert-system.local/traffic.owl"/>

<owl:ObjectProperty rdf:about="#basedOn">
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:range rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">căn cứ vào</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#instanceOfAct">
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:range rdf:resource="#Act"/>
  <rdfs:label xml:lang="vi">là thể hiện của hành vi</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requiresContext">
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#RoadType"/>
        <rdf:Description rdf:about="#TimeContext"/>
        <rdf:Description rdf:about="#AlcoholLevel"/>
        <rdf:Description rdf:about="#SpeedBand"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <rdfs:label xml:lang="vi">yêu cầu ngữ cảnh</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#escalatesTo">
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:range rdf:resource="#Violation"/>
  <owl:inverseOf rdf:resource="#escalatedFrom"/>
  <rdfs:label xml:lang="vi">chuyển khung thành</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#excludes">
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:range rdf:resource="#Violation"/>
  <rdfs:label xml:lang="vi">loại trừ</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSanction">
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:range rdf:resource="#AdditionalSanction"/>
  <rdfs:label xml:lang="vi">có chế tài bổ sung</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appliesToVehicle">
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:range rdf:resource="#VehicleClass"/>
  <rdfs:label xml:lang="vi">áp dụng cho phương tiện</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#escalatedFrom">
  <owl:inverseOf rdf:resource="#escalatesTo"/>
  <rdfs:label xml:lang="vi">được chuyển khung từ</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#fineMin">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:label xml:lang="vi">mức phạt tối thiểu (đồng)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fineMax">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:label xml:lang="vi">mức phạt tối đa (đồng)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#pointsDeducted">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:domain rdf:resource="#Violation"/>
  <rdfs:label xml:lang="vi">số điểm giấy phép lái xe bị trừ</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#legalExcerpt">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="vi">trích nguyên văn quy định</rdfs:label>
</owl:DatatypeProperty>

<owl:Class rdf:about="#VehicleClass">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Loại phương tiện</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Act">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Hành vi</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RoadType">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Loại đường</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#TimeContext">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Bối cảnh thời gian</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AlcoholLevel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Mức nồng độ cồn</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SpeedBand">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Khoảng vượt tốc độ</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Consequence">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Hậu quả</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ResistanceBehavior">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Hành vi chống đối</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Circumstance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Tình tiết</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Subject">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Chủ thể vi phạm</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AdditionalSanction">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Hình thức xử phạt bổ sung, biện pháp khắc phục</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Violation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Vi phạm</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#LegalProvision">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="vi">Quy định pháp luật</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Aggravating">
  <rdfs:subClassOf rdf:resource="#Circumstance"/>
  <owl:disjointWith rdf:resource="#Mitigating"/>
  <rdfs:label xml:lang="vi">Tình tiết tăng nặng</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Mitigating">
  <rdfs:subClassOf rdf:resource="#Circumstance"/>
  <rdfs:label xml:lang="vi">Tình tiết giảm nhẹ</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RevokeLicenseSanction">
  <rdfs:subClassOf rdf:resource="#AdditionalSanction"/>
  <rdfs:label xml:lang="vi">Tước quyền sử dụng giấy phép lái xe</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ConfiscationSanction">
  <rdfs:subClassOf rdf:resource="#AdditionalSanction"/>
  <rdfs:label xml:lang="vi">Tịch thu phương tiện</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RemedialMeasure">
  <rdfs:subClassOf rdf:resource="#AdditionalSanction"/>
  <rdfs:label xml:lang="vi">Biện pháp khắc phục hậu quả</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VEH_ANY">
  <rdfs:subClassOf rdf:resource="#VehicleClass"/>
  <rdfs:label xml:lang="vi">Phương tiện bất kỳ</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VEH_MOTOR">
  <rdfs:subClassOf rdf:resource="#VEH_ANY"/>
  <rdfs:label xml:lang="vi">Phương tiện cơ giới</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VEH_CAR">
  <rdfs:subClassOf rdf:resource="#VEH_MOTOR"/>
  <owl:disjointWith rdf:resource="#VEH_MOTORBIKE"/>
  <rdfs:label xml:lang="vi">Ô tô</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VEH_MOTORBIKE">
  <rdfs:subClassOf rdf:resource="#VEH_MOTOR"/>
  <rdfs:label xml:lang="vi">Mô tô, xe gắn máy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VEH_SPECIAL">
  <rdfs:subClassOf rdf:resource="#VEH_ANY"/>
  <rdfs:label xml:lang="vi">Xe máy chuyên dùng</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VEH_BICYCLE_RUDIMENTARY">
  <rdfs:subClassOf rdf:resource="#VEH_ANY"/>
  <rdfs:label xml:lang="vi">Xe đạp, xe thô sơ</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VEH_PEDESTRIAN">
  <rdfs:subClassOf rdf:resource="#VEH_ANY"/>
  <rdfs:label xml:lang="vi">Người đi bộ</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AlcoholViolation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Violation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#instanceOfAct"/>
          <owl:hasValue rdf:resource="#ACT_ALCOHOL"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Vi phạm nồng độ cồn</rdfs:label>
  <rdfs:comment xml:lang="vi">Violation ⊓ ∃instanceOfAct.{ACT_ALCOHOL}</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CarViolation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Violation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#appliesToVehicle"/>
          <owl:someValuesFrom rdf:resource="#VEH_CAR"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Vi phạm của ô tô</rdfs:label>
  <rdfs:comment xml:lang="vi">Violation ⊓ ∃appliesToVehicle.VEH_CAR</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MotorVehicleViolation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Violation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#appliesToVehicle"/>
          <owl:someValuesFrom rdf:resource="#VEH_MOTOR"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Vi phạm của phương tiện cơ giới</rdfs:label>
  <rdfs:comment xml:lang="vi">Violation ⊓ ∃appliesToVehicle.VEH_MOTOR</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LicenseRevokingViolation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Violation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSanction"/>
          <owl:someValuesFrom rdf:resource="#RevokeLicenseSanction"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Vi phạm bị tước giấy phép lái xe</rdfs:label>
  <rdfs:comment xml:lang="vi">Violation ⊓ ∃hasSanction.RevokeLicenseSanction</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EscalatedViolation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Violation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#escalatedFrom"/>
          <owl:someValuesFrom rdf:resource="#Violation"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Vi phạm ở khung chuyển nặng</rdfs:label>
  <rdfs:comment xml:lang="vi">Violation ⊓ ∃escalatedFrom.Violation (escalatedFrom ≡ escalatesTo⁻)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#HighPointViolation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Violation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#pointsDeducted"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Vi phạm bị trừ từ 10 điểm</rdfs:label>
  <rdfs:comment xml:lang="vi">Violation ⊓ ∃pointsDeducted.xsd:integer[≥ 10]</rdfs:comment>
</owl:Class>

<owl:NamedIndividual rdf:about="#VEH_ANY_individual">
  <rdf:type rdf:resource="#VEH_ANY"/>
  <rdfs:label xml:lang="vi">Phương tiện bất kỳ</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VEH_MOTOR_individual">
  <rdf:type rdf:resource="#VEH_MOTOR"/>
  <rdfs:label xml:lang="vi">Phương tiện cơ giới</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VEH_CAR_individual">
  <rdf:type rdf:resource="#VEH_CAR"/>
  <rdfs:label xml:lang="vi">Ô tô</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VEH_MOTORBIKE_individual">
  <rdf:type rdf:resource="#VEH_MOTORBIKE"/>
  <rdfs:label xml:lang="vi">Mô tô, xe gắn máy</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VEH_SPECIAL_individual">
  <rdf:type rdf:resource="#VEH_SPECIAL"/>
  <rdfs:label xml:lang="vi">Xe máy chuyên dùng</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VEH_BICYCLE_RUDIMENTARY_individual">
  <rdf:type rdf:resource="#VEH_BICYCLE_RUDIMENTARY"/>
  <rdfs:label xml:lang="vi">Xe đạp, xe thô sơ</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VEH_PEDESTRIAN_individual">
  <rdf:type rdf:resource="#VEH_PEDESTRIAN"/>
  <rdfs:label xml:lang="vi">Người đi bộ</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D1-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 1 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 1
1. Nghị định này quy định về hành vi vi phạm hành chính; hình thức, mức xử phạt, biện pháp khắc phục hậu quả đối với từng hành vi vi phạm hành chính; thẩm quyền lập biên bản, thẩm quyền xử phạt, mức phạt tiền cụ thể theo từng chức danh đối với hành vi vi phạm hành chính trong lĩnh vực giao thông đường bộ và đường sắt.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D1-K2">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 1 Khoản 2</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 1
2. Các hành vi vi phạm hành chính trong các lĩnh vực quản lý nhà nước khác liên quan đến lĩnh vực giao thông đường bộ và đường sắt mà không quy định tại Nghị định này thì áp dụng quy định tại các Nghị định quy định về xử phạt vi phạm hành chính trong các lĩnh vực đó để xử phạt.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
1. Cá nhân, tổ chức có hành vi vi phạm hành chính trong lĩnh vực giao thông đường bộ, đường sắt trên lãnh thổ nước Cộng hòa xã hội chủ nghĩa Việt Nam.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
a) Cơ quan nhà nước có hành vi vi phạm mà hành vi đó không thuộc nhiệm vụ quản lý nhà nước được giao;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
b) Đơn vị lực lượng vũ trang nhân dân;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
c) Đơn vị sự nghiệp công lập;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
d) Cơ quan Đảng Cộng sản Việt Nam;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
đ) Tổ chức chính trị - xã hội, tổ chức chính trị xã hội - nghề nghiệp, tổ chức xã hội, tổ chức xã hội - nghề nghiệp;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
e) Tổ chức kinh tế được thành lập theo quy định của Luật Doanh nghiệp gồm: Doanh nghiệp tư nhân, công ty cổ phần, công ty trách nhiệm hữu hạn, công ty hợp danh và các đơn vị phụ thuộc doanh nghiệp (chi nhánh, văn phòng đại diện);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
g) Tổ chức kinh tế được thành lập theo quy định của Luật Hợp tác xã gồm: Hợp tác xã, liên hiệp hợp tác xã;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
h) Tổ chức được thành lập theo quy định của Luật Đầu tư gồm: Nhà đầu tư trong nước, nhà đầu tư nước ngoài và tổ chức kinh tế có vốn đầu tư nước ngoài; chi nhánh, văn phòng đại diện của thương nhân, doanh nghiệp nước ngoài tại Việt Nam; văn phòng đại diện của tổ chức xúc tiến thương mại nước ngoài tại Việt Nam;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K2-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 2 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
i) Các tổ chức khác được thành lập theo quy định của pháp luật.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
3. Hộ kinh doanh, hộ gia đình, tổ hợp tác thực hiện hành vi vi phạm hành chính quy định tại Nghị định này bị xử phạt như đối với cá nhân vi phạm.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D2-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 2 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
4. Người có thẩm quyền lập biên bản, thẩm quyền xử phạt vi phạm hành chính và tổ chức, cá nhân có liên quan đến việc xử phạt vi phạm hành chính theo quy định tại Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
a) Máy kéo là loại xe gồm phần đầu máy tự di chuyển, được lái bằng càng hoặc vô lăng và rơ moóc được kéo theo (có thể tháo rời với phần đầu kéo);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
b) Các loại xe tương tự xe ô tô là loại phương tiện giao thông đường bộ chạy bằng động cơ có từ hai trục, bốn bánh xe trở lên, có phần động cơ và thùng hàng (nếu có) lắp trên cùng một xát xi (kể cả loại xe 4 bánh chạy bằng năng lượng điện);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
c) Các loại xe tương tự xe mô tô là phương tiện giao thông đường bộ chạy bằng động cơ, có hai bánh hoặc ba bánh, có dung tích làm việc của động cơ từ 50 cm3 trở lên, có vận tốc thiết kế lớn nhất lớn hơn 50 km/h, có khối lượng bản thân không lớn hơn 400 kg;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
d) Xe máy điện là xe gắn máy được dẫn động bằng động cơ điện có công suất lớn nhất không lớn hơn 4 kW, có vận tốc thiết kế lớn nhất không lớn hơn 50 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
đ) Các loại xe tương tự xe gắn máy là phương tiện giao thông đường bộ chạy bằng động cơ, có hai bánh hoặc ba bánh và vận tốc thiết kế lớn nhất không lớn hơn 50 km/h, trừ các xe quy định tại điểm e khoản này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K1-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 1 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
e) Xe đạp máy là xe thô sơ hai bánh có lắp động cơ, vận tốc thiết kế lớn nhất không lớn hơn 25 km/h và khi tắt máy thì đạp xe đi được (kể cả xe đạp điện).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
a) Dốc gù là hệ thống thiết bị phục vụ công tác dồn tàu mà khi đầu máy đẩy đoàn toa xe đến đỉnh dốc, sẽ tiến hành tác nghiệp cắt nối toa xe để các toa xe lợi dụng thế năng của đỉnh dốc tự chạy vào các đường trong bãi dồn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
b) Dồn phóng là phương pháp lợi dụng động năng của đoàn dồn để phóng toa xe hoặc cụm toa xe vào các đường trong bãi dồn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
c) Thả trôi là phương pháp lợi dụng thế năng của đường dồn tàu để thả cho toa xe hoặc cụm toa xe tự chạy vào các đường trong bãi dồn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
d) Cắt hớt là phương pháp cắt cụm toa xe khi đoàn dồn đang dịch chuyển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
đ) Chế độ hô đáp là quy định bắt buộc mà người được quy định hô các mệnh lệnh, thực hiện các biểu thị và người chấp hành các mệnh lệnh, biểu thị phải đáp lại đúng nội dung đã nhận được;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
e) Cấp cảnh báo là thông báo bằng văn bản cho các nhân viên đường sắt trực tiếp phục vụ chạy tàu liên quan về tình trạng bất bình thường của kết cấu hạ tầng đường sắt, phương tiện giao thông đường sắt và các trường hợp cần thiết khác, kèm theo các biện pháp thực hiện nhằm bảo đảm an toàn chạy tàu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
g) Khổ giới hạn tiếp giáp kiến trúc đường sắt là khoảng không gian dọc theo đường sắt đủ để tàu chạy qua không bị va quệt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
h) Phạm vi an toàn đường ngang là đoạn đường bộ đi qua đường sắt nằm giữa hai cần chắn, giàn chắn (bao gồm cả cần chắn, giàn chắn) hoặc nằm giữa hai ray chính ngoài cùng và hai bên đường sắt cách má ray ngoài cùng trở ra 06 m nơi không có chắn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D3-K2-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 3 Khoản 2 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 3
i) Phạm vi an toàn cầu chung là phạm vi giữa hai cần chắn, giàn chắn (bao gồm cả cần chắn, giàn chắn) hoặc phạm vi từ mép trong của mố (giáp đầu dầm) hai đầu cầu trở ra mỗi bên 10 m ở nơi không có cần chắn, giàn chắn.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
a) Buộc khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
b) Buộc tháo dỡ công trình, phần công trình xây dựng không có giấy phép hoặc xây dựng không đúng với giấy phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
c) Buộc thực hiện biện pháp để khắc phục tình trạng ô nhiễm môi trường do vi phạm hành chính gây ra;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
d) Buộc tái xuất phương tiện khỏi Việt Nam;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
đ) Buộc nộp lại số lợi bất hợp pháp có được do thực hiện vi phạm hành chính;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K1-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 1 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
e) Các biện pháp khắc phục hậu quả khác được quy định tại khoản 2 và khoản 3 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
a) Buộc phải tháo dỡ các vật che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông hoặc buộc phải di dời cây trồng không đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
b) Buộc phải thu dọn thóc, lúa, rơm, rạ, nông, lâm, hải sản, rác, chất phế thải, phương tiện, vật tư, vật liệu, hàng hóa, máy móc, thiết bị, biển hiệu, biển quảng cáo, đinh, vật sắc nhọn, dây, các loại vật dụng, vật cản khác;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
c) Buộc phải thực hiện ngay các biện pháp bảo đảm an toàn giao thông theo quy định hoặc buộc phải treo biển báo thông tin công trình có đầy đủ nội dung theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
d) Buộc phải xây dựng lại bến xe, bãi đỗ xe, trạm dừng nghỉ, trạm thu phí đường bộ theo đúng quy định, bảo đảm tiêu chuẩn kỹ thuật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
đ) Buộc phải bổ sung hoặc sửa chữa các biển báo hiệu bị mất, bị hư hỏng và khắc phục các hư hỏng của công trình đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
e) Buộc phải lắp đầy đủ thiết bị hoặc thay thế thiết bị đủ tiêu chuẩn an toàn kỹ thuật hoặc khôi phục lại tính năng kỹ thuật của phương tiện, thiết bị theo quy định hoặc tháo bỏ những thiết bị lắp thêm không đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
g) Buộc phải bố trí phương tiện khác để chở số hành khách vượt quá quy định được phép chở của phương tiện;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
h) Buộc phải đăng ký, niêm yết đầy đủ, chính xác các thông tin theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
i) Buộc phải gắn hộp đèn với chữ "TAXI" hoặc buộc phải niêm yết cụm từ "XE TAXI", "XE HỢP ĐỒNG", "XE DU LỊCH" theo đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
k) Buộc phải cấp "thẻ nhận dạng lái xe" cho lái xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
l) Buộc phải tổ chức tập huấn nghiệp vụ hoặc tổ chức khám sức khỏe định kỳ cho lái xe và nhân viên phục vụ trên xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
m) Buộc phải ký hợp đồng với lái xe và nhân viên phục vụ trên xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
n) Buộc phải xây dựng và thực hiện quy trình bảo đảm an toàn giao thông theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
o) Buộc phải bố trí người trực tiếp điều hành hoạt động vận tải đủ điều kiện theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
p) Buộc phải lắp đặt camera, dây an toàn, đồng hồ tính tiền cước, thiết bị in hóa đơn, thiết bị giám sát hành trình trên xe theo đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
q) Buộc phải cung cấp, cập nhật, truyền, lưu trữ, quản lý các thông tin từ thiết bị giám sát hành trình, camera lắp trên xe ô tô theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pr">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm r</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
r) Buộc phải cung cấp tên đăng nhập, mật khẩu truy cập vào phần mềm xử lý dữ liệu từ thiết bị giám sát hành trình của xe ô tô hoặc máy chủ của đơn vị cho cơ quan có thẩm quyền theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Ps">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm s</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
s) Buộc phải lập, cập nhật, lưu trữ đầy đủ, chính xác lý lịch phương tiện, lý lịch hành nghề của lái xe, các hồ sơ, tài liệu có liên quan trong quá trình quản lý, điều hành hoạt động vận tải của đơn vị theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pt">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm t</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
t) Buộc phải khôi phục lại nhãn hiệu, màu sơn ghi trong Giấy đăng ký xe theo quy định hoặc buộc phải thực hiện đúng quy định về biển số, quy định về kẻ chữ trên thành xe và cửa xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pu">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm u</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
u) Buộc phải khôi phục lại hình dáng, kích thước, tình trạng an toàn kỹ thuật ban đầu của xe và đăng kiểm lại trước khi đưa phương tiện ra tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Pv">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm v</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
v) Buộc phải thực hiện điều chỉnh thùng xe theo đúng quy định hiện hành, đăng kiểm lại và điều chỉnh lại khối lượng hàng hóa cho phép chuyên chở ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định hiện hành trước khi đưa phương tiện ra tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Px">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm x</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
x) Buộc phải làm thủ tục đăng ký xe, đăng ký sang tên hoặc thủ tục đổi lại, thu hồi Giấy đăng ký xe, biển số xe, Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K2-Py">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 2 Điểm y</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
y) Buộc phải đưa phương tiện quay trở lại Khu kinh tế thương mại đặc biệt, Khu kinh tế cửa khẩu quốc tế.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
a) Buộc phải lắp đặt đúng, đủ và duy trì hoạt động bình thường của hệ thống báo hiệu, tín hiệu, thiết bị theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
b) Buộc phải tổ chức thử hãm hoặc tổ chức thực hiện phòng vệ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
c) Buộc phải để toa xe chở hàng nguy hiểm (chất nổ, chất cháy) hoặc để ghi dẫn sang đường khác theo đúng quy định về dồn tàu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
d) Buộc phải ra khỏi đường sắt, cầu, hầm dành riêng cho đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
đ) Buộc phải đưa đất, đá, cát, vật chướng ngại, rơm, rạ, nông sản, rác thải sinh hoạt, chất độc hại, chất phế thải, chất dễ cháy, dễ nổ các loại vật tư, vật liệu, vật phẩm khác ra khỏi đường sắt, công trình đường sắt khác hoặc phạm vi đất dành cho đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
e) Buộc phải đưa bè, mảng, phương tiện vận tải thủy hoặc các vật thể khác ra khỏi phạm vi bảo vệ cầu đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
g) Buộc phải đưa phương tiện giao thông đường bộ, vật tư, vật liệu, máy móc thiết bị, hàng hóa, biển phòng vệ, biển báo tạm thời ra khỏi khổ giới hạn tiếp giáp kiến trúc đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
h) Buộc phải thực hiện ngay các biện pháp bảo đảm an toàn công trình đường sắt, bảo đảm an toàn giao thông đường sắt theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
i) Buộc phải dỡ bỏ vật che khuất biển hiệu, mốc hiệu, tín hiệu của công trình đường sắt hoặc đưa tấm đan bê tông, gỗ, sắt thép, các vật liệu khác (đặt trái phép) ra khỏi phạm vi bảo vệ công trình đường sắt hoặc hạ độ cao của cây trồng có chiều cao vượt quá quy định, di dời cây trồng không đúng quy định hoặc có ảnh hưởng đến an toàn công trình, an toàn giao thông đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
k) Buộc đưa phương tiện, thiết bị, vật liệu, hàng hóa, chất phế thải, các vật phẩm khác (để trái phép) ra khỏi phạm vi bảo vệ công trình đường sắt, hành lang an toàn giao thông đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
l) Buộc phải tháo dỡ, di chuyển các công trình, nhà ở, lều, quán gây trở ngại cho việc xây dựng, cải tạo, mở rộng và bảo đảm an toàn công trình đường sắt hoặc buộc phải tháo dỡ, di chuyển lều, quán (dựng trái phép), biển quảng cáo, biển chỉ dẫn, các vật che chắn khác (đặt, treo trái phép) ra khỏi phạm vi đất dành cho đường sắt hoặc buộc phải phá dỡ công trình hết hạn sử dụng, tháo dỡ công trình bị thu hồi, hủy giấy phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
m) Buộc phải gia cố, di chuyển hoặc cải tạo công trình gây ảnh hưởng đến an toàn giao thông đường sắt theo yêu cầu của cơ quan có thẩm quyền;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
n) Buộc phải tổ chức sửa chữa, bổ sung, gia cố, thay thế các hư hỏng kết cấu hạ tầng đường sắt để bảo đảm chất lượng theo công lệnh tốc độ, công lệnh tải trọng đã công bố;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
o) Buộc phải bố trí đủ thiết bị an toàn, tín hiệu, biển báo, tín hiệu phòng vệ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
p) Buộc phải để phương tiện, vật liệu, thiết bị thi công theo đúng quy định, không gây cản trở chạy tàu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
q) Buộc phải lắp đầy đủ theo đúng quy định hoặc thay thế thiết bị đủ tiêu chuẩn an toàn kỹ thuật hoặc khôi phục lại tính năng kỹ thuật của các thiết bị, gồm: thiết bị hãm tự động, hãm bằng tay; van hãm khẩn cấp, đồng hồ áp suất (tại vị trí làm việc của trưởng tàu và trên toa xe khách); thiết bị ghép nối đầu máy, toa xe; thiết bị tín hiệu đuôi tàu; đồng hồ báo tốc độ, thiết bị ghi tốc độ và các thông tin liên quan đến việc điều hành chạy tàu (hộp đen); thiết bị cảnh báo để lái tàu tỉnh táo trong khi lái tàu; thiết bị đo tốc độ tàu, thiết bị thông tin liên lạc giữa trưởng tàu và lái tàu (tại vị trí làm việc của trưởng tàu);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pr">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm r</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
r) Buộc phải khôi phục lại kết cấu, hình dáng, tính năng sử dụng ban đầu của phương tiện trước khi đưa phương tiện tham gia giao thông trên đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Ps">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm s</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
s) Buộc phải bổ sung đầy đủ theo quy định trên tàu khách hoặc tàu hàng về: thiết bị, dụng cụ, vật liệu chữa cháy; thuốc sơ, cấp cứu; dụng cụ thoát hiểm; dụng cụ chèn tàu; dụng cụ, vật liệu để sửa chữa đơn giản; tín hiệu cầm tay;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pt">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm t</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
t) Buộc phải hướng dẫn người vi phạm về vị trí quy định hoặc đưa người, hàng hóa ra khỏi đầu máy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pu">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm u</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
u) Buộc phải bố trí phương tiện khác để chở số hành khách vượt quá quy định được phép chở của toa xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Pv">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm v</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
v) Buộc thu hồi và tiêu hủy bằng, chứng chỉ chuyên môn đã cấp trái phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Px">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm x</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
x) Buộc phải đưa thi hài, hài cốt, động vật sống, động vật có dịch bệnh, chất dễ cháy, dễ nổ, vũ khí, hàng nguy hiểm, xuống tàu (tại ga đến gần nhất trong trường hợp tàu đang chạy), ra ga để xử lý theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K3-Py">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 3 Điểm y</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
y) Buộc phải thực hiện ngay nhiệm vụ vận tải đặc biệt, an sinh xã hội theo yêu cầu của người đứng đầu cơ quan quản lý nhà nước có thẩm quyền theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D4-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 4 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 4
4. Nguyên tắc áp dụng biện pháp khắc phục hậu quả được thực hiện theo quy định tại khoản 2 Điều 28 của Luật Xử lý vi phạm hành chính.
Chương II HÀNH VI VI PHẠM, HÌNH THỨC, MỨC XỬ PHẠT VÀ BIỆN PHÁP KHẮC PHỤC HẬU QUẢ VI PHẠM HÀNH CHÍNH TRONG LĨNH VỰC GIAO THÔNG ĐƯỜNG BỘ
Mục 1 VI PHẠM QUY TẮC GIAO THÔNG ĐƯỜNG BỘ</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm a, điểm d, điểm g, điểm h, điểm i, điểm k khoản 2; điểm a, điểm d, điểm đ, điểm e, điểm k, điểm l, điểm o, điểm r, điểm s khoản 3; điểm b, điểm c, điểm d, điểm đ, điểm I khoản 4; điểm a, điểm c, điểm d, điểm đ, điểm e, điểm g, điểm i khoản 5; điểm a, điểm b khoản 6; điểm a, điểm c khoản 7; điểm a khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Chuyển hướng không nhường quyền đi trước cho: Người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ; xe thô sơ đang đi trên phần đường dành cho xe thô sơ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Chuyển hướng không nhường đường cho: Các xe đi ngược chiều; người đi bộ, xe lăn của người khuyết tật đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
d) Khi dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
đ) Khi đỗ xe chiếm một phần đường xe chạy không đặt ngay báo hiệu nguy hiểm theo quy định, trừ hành vi vi phạm quy định tại điểm c khoản 6 Điều này và trường hợp đỗ xe tại vị trí quy định được phép đỗ xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K1-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 1 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
e) Không gắn biển báo hiệu ở phía trước xe kéo, phía sau xe được kéo; điều khiển xe kéo rơ moóc không có biển báo hiệu theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K1-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 1 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
g) Bấm còi trong đô thị và khu đông dân cư trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước, trừ các hành vi vi phạm quy định tại điểm g khoản 5 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Điều khiển xe chạy tốc độ thấp hơn các xe khác đi cùng chiều mà không đi về bên phải phần đường xe chạy, trừ trường hợp các xe khác đi cùng chiều chạy quá tốc độ quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Chở người trên buồng lái quá số lượng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
d) Không tuân thủ các quy định về nhường đường tại nơi đường bộ giao nhau, trừ các hành vi vi phạm quy định tại điểm m, điểm n khoản 3 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
đ) Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không dừng lại, không giữ nguyên hiện trường, không tham gia cấp cứu người bị nạn, trừ hành vi vi phạm quy định tại điểm b khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
e) Xe được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu ưu tiên không đúng quy định hoặc sử dụng thiết bị phát tín hiệu ưu tiên mà không có giấy phép của cơ quan có thẩm quyền cấp hoặc có giấy phép của cơ quan có thẩm quyền cấp nhưng không còn giá trị sử dụng theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
g) Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng; dừng xe, đỗ xe không sát mép đường phía bên phải theo chiều đi ở nơi đường có lề đường hẹp hoặc không có lề đường; dừng xe, đỗ xe ngược với chiều lưu thông của làn đường; dừng xe, đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy; đỗ xe trên dốc không chèn bánh; mở cửa xe, để cửa xe mở không bảo đảm an toàn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
h) Dừng xe không sát theo lề đường, hè phố phía bên phải theo chiều đi hoặc bánh xe gần nhất cách lề đường, hè phố quá 0,25 m; dừng xe trên đường xe điện, đường dành riêng cho xe buýt; dừng xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước; rời vị trí lái, tắt máy khi dừng xe; dừng xe, đỗ xe không đúng vị trí quy định ở những đoạn có bố trí nơi dừng xe, đỗ xe; dừng xe, đỗ xe trên phần đường dành cho người đi bộ qua đường; dừng xe nơi có biển "Cấm dừng xe và đỗ xe", trừ hành vi vi phạm quy định tại điểm i khoản 4, điểm b khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
i) Quay đầu xe trái quy định trong khu dân cư;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K2-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 2 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
k) Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, ngầm, gầm cầu vượt, trừ trường hợp tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Điều khiển xe chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Bấm còi, rú ga liên tục; bấm còi hơi, sử dụng đèn chiếu xa trong đô thị, khu đông dân cư, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Chuyển hướng không giảm tốc độ hoặc không có tín hiệu báo hướng rẽ (trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
d) Không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt; dừng xe, đỗ xe trong phạm vi an toàn của đường sắt, trừ hành vi vi phạm quy định tại điểm b khoản 2, điểm b khoản 3 Điều 49 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
đ) Dừng xe, đỗ xe tại vị trí: nơi đường bộ giao nhau hoặc trong phạm vi 05 m tính từ mép đường giao nhau; điểm dừng đón, trả khách của xe buýt; trước cổng hoặc trong phạm vi 05 m hai bên cổng trụ sở cơ quan, tổ chức có bố trí đường cho xe ô tô ra vào; nơi phần đường có bề rộng chỉ đủ cho một làn xe; che khuất biển báo hiệu đường bộ; nơi mở dải phân cách giữa;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
e) Đỗ xe không sát theo lề đường, hè phố phía bên phải theo chiều đi hoặc bánh xe gần nhất cách lề đường, hè phố quá 0,25 m; đỗ xe trên đường xe điện, đường dành riêng cho xe buýt; đỗ xe trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, chỗ dành riêng cho xe chữa cháy lấy nước; đỗ, để xe ở hè phố trái quy định của pháp luật; đỗ xe nơi có biển "Cấm đỗ xe" hoặc biển "Cấm dừng xe và đỗ xe", trừ hành vi vi phạm quy định tại điểm i khoản 4, điểm b khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
g) Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 19 giờ ngày hôm trước đến 05 giờ ngày hôm sau, khi sương mù, thời tiết xấu hạn chế tầm nhìn; sử dụng đèn chiếu xa khi tránh xe đi ngược chiều;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
h) Điều khiển xe ô tô kéo theo xe khác, vật khác (trừ trường hợp kéo theo một rơ moóc, sơ mi rơ moóc hoặc một xe ô tô, xe máy chuyên dùng khác khi xe này không tự chạy được); điều khiển xe ô tô đẩy xe khác, vật khác; điều khiển xe kéo rơ moóc, sơ mi rơ moóc kéo thêm rơ moóc hoặc xe khác, vật khác; không nối chắc chắn, an toàn giữa xe kéo và xe được kéo khi kéo nhau;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
i) Chở người trên xe được kéo, trừ người điều khiển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
k) Quay đầu xe tại nơi đường bộ giao nhau cùng mức với đường sắt; quay đầu xe tại nơi đường hẹp, đường dốc, đoạn đường cong tầm nhìn bị che khuất, nơi có biển báo "Cấm quay đầu xe";</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
l) Không giữ khoảng cách an toàn để xảy ra va chạm với xe chạy liền trước hoặc không giữ khoảng cách theo quy định của biển báo hiệu "Cự ly tối thiểu giữa hai xe", trừ các hành vi vi phạm quy định tại điểm g khoản 5 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
m) Không giảm tốc độ và nhường đường khi điều khiển xe chạy từ trong ngõ, đường nhánh ra đường chính;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
n) Không nhường đường cho xe đi trên đường ưu tiên, đường chính từ bất kỳ hướng nào tới tại nơi đường giao nhau;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
o) Lùi xe ở đường một chiều, đường có biển "Cấm đi ngược chiều", khu vực cấm dừng, trên phần đường dành cho người đi bộ qua đường, nơi đường bộ giao nhau, nơi đường bộ giao nhau cùng mức với đường sắt, nơi tầm nhìn bị che khuất; lùi xe không quan sát hoặc không có tín hiệu báo trước, trừ hành vi vi phạm quy định tại điểm a khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
p) Không thắt dây an toàn khi điều khiển xe chạy trên đường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
q) Chở người trên xe ô tô không thắt dây an toàn (tại vị trí có trang bị dây an toàn) khi xe đang chạy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Pr">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm r</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
r) Chạy trong hầm đường bộ không sử dụng đèn chiếu sáng gần;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K3-Ps">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 3 Điểm s</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
s) Điều khiển xe chạy dưới tốc độ tối thiểu trên những đoạn đường bộ có quy định tốc độ tối thiểu cho phép.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Dùng tay sử dụng điện thoại di động khi đang điều khiển xe chạy trên đường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm c khoản 5, điểm a khoản 8 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Điều khiển xe không đủ điều kiện để thu phí theo hình thức điện tử tự động không dừng đi vào làn đường dành riêng thu phí theo hình thức điện tử tự động không dừng tại các trạm thu phí;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
d) Dừng xe, đỗ xe tại vị trí: Bên trái đường một chiều hoặc bên trái (theo hướng lưu thông) của đường đôi; trên đoạn đường cong hoặc gần đầu dốc nơi tầm nhìn bị che khuất; trên cầu, gầm cầu vượt, song song với một xe khác đang dừng, đỗ, trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
đ) Dừng xe, đỗ xe, quay đầu xe trái quy định gây ùn tắc giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
e) Xe không được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu của xe được quyền ưu tiên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
g) Không thực hiện biện pháp bảo đảm an toàn theo quy định khi xe ô tô bị hư hỏng ngay tại nơi đường bộ giao nhau cùng mức với đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
h) Không nhường đường cho xe xin vượt khi có đủ điều kiện an toàn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K4-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 4 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
i) Lùi xe, quay đầu xe trong hầm đường bộ; dừng xe, đỗ xe, vượt xe trong hầm đường bộ không đúng nơi quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Không chấp hành hiệu lệnh của đèn tín hiệu giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển "Cấm đi ngược chiều", trừ các hành vi vi phạm quy định tại điểm a khoản 8 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
d) Vượt xe trong những trường hợp không được vượt, vượt xe tại đoạn đường có biển báo hiệu có nội dung cấm vượt (đối với loại phương tiện đang điều khiển); không có báo hiệu trước khi vượt; vượt bên phải xe khác trong trường hợp không được phép, trừ trường hợp tại đoạn đường có nhiều làn đường cho xe đi cùng chiều được phân biệt bằng vạch kẻ phân làn đường mà xe chạy trên làn đường bên phải chạy nhanh hơn xe đang chạy trên làn đường bên trái;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
đ) Điều khiển xe không đi bên phải theo chiều đi của mình; đi không đúng phần đường hoặc làn đường quy định (làn cùng chiều hoặc làn ngược chiều) trừ hành vi quy định tại điểm c khoản 4 Điều này; điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy; điều khiển xe đi trên hè phố, trừ trường hợp điều khiển xe đi qua hè phố để vào nhà;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
e) Tránh xe đi ngược chiều không đúng quy định, trừ hành vi vi phạm sử dụng đèn chiếu xa khi tránh xe đi ngược chiều quy định tại điểm g khoản 3 Điều này; không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
g) Không tuân thủ các quy định khi vào hoặc ra đường cao tốc; điều khiển xe chạy ở làn dừng xe khẩn cấp hoặc phần lề đường của đường cao tốc; chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước khi chạy trên đường cao tốc; không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
h) Không nhường đường hoặc gây cản trở xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K5-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 5 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
i) Điều khiển xe chạy quá tốc độ quy định từ 10 km/h đến 20 km/h.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Điều khiển xe chạy quá tốc độ quy định trên 20 km/h đến 35 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Dừng xe, đỗ xe trên đường cao tốc không đúng nơi quy định; không có báo hiệu để người lái xe khác biết khi buộc phải dừng xe, đỗ xe trên đường cao tốc không đúng nơi quy định; quay đầu xe trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Không chú ý quan sát, điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông; dừng xe, đỗ xe, quay đầu xe, lùi xe, tránh xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định gây tai nạn giao thông; không đi đúng phần đường, làn đường, không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông hoặc đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển "Cấm đi ngược chiều" gây tai nạn giao thông, trừ các hành vi vi phạm quy định tại điểm a khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Điều khiển xe lạng lách, đánh võng; chạy quá tốc độ đuổi nhau trên đường bộ; dùng chân điều khiển vô lăng xe khi xe đang chạy trên đường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K7-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 7 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Điều khiển xe chạy quá tốc độ quy định trên 35 km/h.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Điều khiển xe đi ngược chiều trên đường cao tốc, lùi xe trên đường cao tốc, trừ các xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Gây tai nạn giao thông không dừng lại, không giữ nguyên hiện trường, bỏ trốn không đến trình báo với cơ quan có thẩm quyền, không tham gia cấp cứu người bị nạn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K9">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 9</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
9. Phạt tiền từ 18.000.000 đồng đến 20.000.000 đồng đối với hành vi vi phạm quy định tại điểm b khoản 7 Điều này mà không chấp hành hiệu lệnh dừng xe của người thi hành công vụ hoặc gây tai nạn giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K10-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 10 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K10-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 10 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K10-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 10 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Điều khiển xe trên đường mà trong cơ thể có chất ma túy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K10-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 10 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
d) Không chấp hành yêu cầu kiểm tra về chất ma túy của người thi hành công vụ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
a) Thực hiện hành vi quy định tại điểm e khoản 4 Điều này bị tịch thu thiết bị phát tín hiệu ưu tiên lắp đặt sử dụng trái quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
b) Thực hiện hành vi quy định tại điểm đ khoản 2; điểm h, điểm i khoản 3; khoản 4; điểm a, điểm b, điểm d, điểm đ, điểm g, điểm h, điểm i khoản 5 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
c) Thực hiện hành vi quy định tại điểm c khoản 5; điểm a, điểm b khoản 6; khoản 7 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng. Thực hiện hành vi quy định tại một trong các điểm, khoản sau của Điều này mà gây tai nạn giao thông thì bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng: điểm a, điểm d, điểm đ, điểm e, điểm g khoản 1; điểm b, điểm d, điểm g khoản 2; điểm b, điểm g, điểm h, điểm m, điểm n, điểm r, điểm s khoản 3; điểm a, điểm c, điểm e, điểm g, điểm h khoản 4; điểm a, điểm b, điểm e, điểm g, điểm h khoản 5 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
d) Thực hiện hành vi quy định tại khoản 9 Điều này hoặc tái phạm hành vi quy định tại điểm b khoản 7 Điều này, bị tước quyền sử dụng Giấy phép lái xe từ 03 tháng đến 05 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
đ) Thực hiện hành vi quy định tại điểm a, điểm b khoản 8 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 05 tháng đến 07 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
e) Thực hiện hành vi quy định tại điểm c khoản 6 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 10 tháng đến 12 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
g) Thực hiện hành vi quy định tại điểm c khoản 8 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 16 tháng đến 18 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D5-K11-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 5 Khoản 11 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 5
h) Thực hiện hành vi quy định tại khoản 10 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 22 tháng đến 24 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm c, điểm đ, điểm e, điểm h khoản 2; điểm d, điểm g, điểm i, điểm m khoản 3; điểm a, điểm b, điểm c, điểm d, điểm e khoản 4; khoản 5; điểm b khoản 6; điểm a, điểm b khoản 7; điểm d khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Không có báo hiệu xin vượt trước khi vượt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Không giữ khoảng cách an toàn để xảy ra va chạm với xe chạy liền trước hoặc không giữ khoảng cách theo quy định của biển báo hiệu "Cự ly tối thiểu giữa hai xe";</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
d) Chuyển hướng không nhường quyền đi trước cho: Người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ; xe thô sơ đang đi trên phần đường dành cho xe thô sơ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
đ) Chuyển hướng không nhường đường cho: Các xe đi ngược chiều; người đi bộ, xe lăn của người khuyết tật đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
e) Lùi xe mô tô ba bánh không quan sát hoặc không có tín hiệu báo trước;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
g) Chở người ngồi trên xe sử dụng ô (dù);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
h) Không tuân thủ các quy định về nhường đường tại nơi đường giao nhau, trừ các hành vi vi phạm quy định tại điểm b, điểm e khoản 2 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
i) Chuyển làn đường không đúng nơi được phép hoặc không có tín hiệu báo trước;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
k) Điều khiển xe chạy dàn hàng ngang từ 03 xe trở lên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
l) Không sử dụng đèn chiếu sáng trong thời gian từ 19 giờ ngày hôm trước đến 05 giờ ngày hôm sau hoặc khi sương mù, thời tiết xấu hạn chế tầm nhìn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
m) Tránh xe không đúng quy định; sử dụng đèn chiếu xa khi tránh xe đi ngược chiều; không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
n) Bấm còi trong thời gian từ 22 giờ ngày hôm trước đến 05 giờ ngày hôm sau, sử dụng đèn chiếu xa trong đô thị, khu đông dân cư, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
o) Xe được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu ưu tiên không đúng quy định hoặc sử dụng thiết bị phát tín hiệu ưu tiên mà không có Giấy phép của cơ quan có thẩm quyền cấp hoặc có Giấy phép của cơ quan có thẩm quyền cấp nhưng không còn giá trị sử dụng theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
p) Quay đầu xe tại nơi không được quay đầu xe, trừ hành vi vi phạm quy định tại điểm d khoản 4 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K1-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 1 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
q) Điều khiển xe chạy dưới tốc độ tối thiểu trên những đoạn đường bộ có quy định tốc độ tối thiểu cho phép.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Không giảm tốc độ và nhường đường khi điều khiển xe chạy từ trong ngõ, đường nhánh ra đường chính;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Điều khiển xe chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
d) Điều khiển xe chạy tốc độ thấp mà không đi bên phải phần đường xe chạy gây cản trở giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
đ) Dừng xe, đỗ xe ở lòng đường đô thị gây cản trở giao thông; tụ tập từ 03 xe trở lên ở lòng đường, trong hầm đường bộ; đỗ, để xe ở lòng đường đô thị, hè phố trái quy định của pháp luật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
e) Không nhường đường cho xe xin vượt khi có đủ điều kiện an toàn; không nhường đường cho xe đi trên đường ưu tiên, đường chính từ bất kỳ hướng nào tới tại nơi đường giao nhau;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
g) Xe không được quyền ưu tiên lắp đặt, sử dụng thiết bị phát tín hiệu của xe được quyền ưu tiên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
h) Dừng xe, đỗ xe trên đường xe điện, điểm dừng đón trả khách của xe buýt, nơi đường bộ giao nhau, trên phần đường dành cho người đi bộ qua đường; dừng xe nơi có biển "Cấm dừng xe và đỗ xe"; đỗ xe tại nơi có biển "Cấm đỗ xe" hoặc biển "Cấm dừng xe và đỗ xe"; không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt; dừng xe, đỗ xe trong phạm vi an toàn của đường sắt, trừ hành vi vi phạm quy định tại điểm b khoản 2, điểm b khoản 3 Điều 49 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
i) Không đội "mũ bảo hiểm cho người đi mô tô, xe máy" hoặc đội "mũ bảo hiểm cho người đi mô tô, xe máy" không cài quai đúng quy cách khi điều khiển xe tham gia giao thông trên đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
k) Chở người ngồi trên xe không đội "mũ bảo hiểm cho người đi mô tô, xe máy" hoặc đội "mũ bảo hiểm cho người đi mô tô, xe máy" không cài quai đúng quy cách, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 06 tuổi, áp giải người có hành vi vi phạm pháp luật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
l) Chở theo 02 người trên xe, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 14 tuổi, áp giải người có hành vi vi phạm pháp luật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K2-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 2 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
m) Ngồi phía sau vòng tay qua người ngồi trước để điều khiển xe, trừ trường hợp chở trẻ em ngồi phía trước.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Chuyển hướng không giảm tốc độ hoặc không có tín hiệu báo hướng rẽ (trừ trường hợp điều khiển xe đi theo hướng cong của đoạn đường bộ ở nơi đường không giao nhau cùng mức);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Chở theo từ 03 người trở lên trên xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Bấm còi, rú ga (nẹt pô) liên tục trong đô thị, khu đông dân cư, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
d) Dừng xe, đỗ xe trên cầu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
đ) Điều khiển xe thành đoàn gây cản trở giao thông, trừ trường hợp được cơ quan có thẩm quyền cấp phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
e) Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không dừng lại, không giữ nguyên hiện trường, không tham gia cấp cứu người bị nạn, trừ hành vi vi phạm quy định tại điểm đ khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
g) Điều khiển xe không đi bên phải theo chiều đi của mình; đi không đúng phần đường, làn đường quy định (làn cùng chiều hoặc làn ngược chiều); điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy; điều khiển xe đi trên hè phố, trừ trường hợp điều khiển xe đi qua hè phố để vào nhà;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
h) Vượt bên phải trong trường hợp không được phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
i) Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại khoản 5, điểm b khoản 6 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
k) Người đang điều khiển xe hoặc chở người ngồi trên xe bám, kéo, đẩy xe khác, vật khác, dẫn dắt súc vật, mang vác vật cồng kềnh; chở người đứng trên yên, giá đèo hàng hoặc ngồi trên tay lái; xếp hàng hóa trên xe vượt quá giới hạn quy định; điều khiển xe kéo theo xe khác, vật khác;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
l) Chở hàng vượt trọng tải thiết kế được ghi trong Giấy đăng ký xe đối với loại xe có quy định về trọng tải thiết kế;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K3-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 3 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
m) Chạy trong hầm đường bộ không sử dụng đèn chiếu sáng gần.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Điều khiển xe chạy quá tốc độ quy định từ 10 km/h đến 20 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Vượt xe trong những trường hợp không được vượt, vượt xe tại đoạn đường có biển báo hiệu có nội dung cấm vượt đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm h khoản 3 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
d) Vượt xe trong hầm đường bộ không đúng nơi quy định; quay đầu xe trong hầm đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
đ) Không nhường đường hoặc gây cản trở xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
e) Không chấp hành hiệu lệnh của đèn tín hiệu giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
g) Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K4-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 4 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
h) Người đang điều khiển xe sử dụng ô (dù), điện thoại di động, thiết bị âm thanh, trừ thiết bị trợ thính.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K5">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 5</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
5. Phạt tiền từ 1.000.000 đồng đến 2.000.000 đồng đối với người điều khiển xe thực hiện hành vi đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển "Cấm đi ngược chiều", trừ hành vi vi phạm quy định tại điểm b khoản 6 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Sử dụng chân chống hoặc vật khác quệt xuống đường khi xe đang chạy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Điều khiển xe đi vào đường cao tốc, trừ xe phục vụ việc quản lý, bảo trì đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Điều khiển xe chạy quá tốc độ quy định trên 20 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Không chú ý quan sát, điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông; đi vào đường cao tốc, dừng xe, đỗ xe, quay đầu xe, lùi xe, tránh xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định gây tai nạn giao thông; không đi đúng phần đường, làn đường, không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông hoặc đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển "Cấm đi ngược chiều" gây tai nạn giao thông, trừ hành vi vi phạm quy định tại điểm d khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K7-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 7 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Buông cả hai tay khi đang điều khiển xe; dùng chân điều khiển xe; ngồi về một bên điều khiển xe; nằm trên yên xe điều khiển xe; thay người điều khiển khi xe đang chạy; quay người về phía sau để điều khiển xe hoặc bịt mắt điều khiển xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Điều khiển xe lạng lách hoặc đánh võng trên đường bộ trong, ngoài đô thị;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Điều khiển xe chạy bằng một bánh đối với xe hai bánh, chạy bằng hai bánh đối với xe ba bánh;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
d) Điều khiển xe thành nhóm từ 02 xe trở lên chạy quá tốc độ quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
đ) Gây tai nạn giao thông không dừng lại, không giữ nguyên hiện trường, bỏ trốn không đến trình báo với cơ quan có thẩm quyền, không tham gia cấp cứu người bị nạn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
e) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
g) Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
h) Điều khiển xe trên đường mà trong cơ thể có chất ma túy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K8-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 8 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
i) Không chấp hành yêu cầu kiểm tra về chất ma túy của người thi hành công vụ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K9">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 9</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
9. Phạt tiền từ 10.000.000 đồng đến 14.000.000 đồng đối với hành vi vi phạm quy định tại điểm a, điểm b, điểm c, điểm d khoản 8 Điều này mà gây tai nạn giao thông hoặc không chấp hành hiệu lệnh dừng xe của người thi hành công vụ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K10-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 10 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
a) Thực hiện hành vi quy định tại điểm g khoản 2 Điều này bị tịch thu thiết bị phát tín hiệu ưu tiên lắp đặt, sử dụng trái quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K10-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 10 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
b) Thực hiện hành vi quy định tại điểm b, điểm e, điểm i khoản 3; điểm đ, điểm e, điểm g, điểm h khoản 4; khoản 5 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K10-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 10 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
c) Thực hiện hành vi quy định tại điểm a khoản 6; điểm a, điểm b khoản 7; điểm a, điểm b, điểm c, điểm d khoản 8 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng; tái phạm hoặc vi phạm nhiều lần hành vi quy định tại điểm a, điểm b, điểm c, điểm d khoản 8 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 03 tháng đến 05 tháng, tịch thu phương tiện. Thực hiện hành vi quy định tại một trong các điểm, khoản sau của Điều này mà gây tai nạn giao thông thì bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng: Điểm a, điểm g, điểm h, điểm k, điểm l, điểm m, điểm n, điểm q khoản 1; điểm b, điểm d, điểm e, điểm g, điểm l, điểm m khoản 2; điểm b, điểm c, điểm k, điểm m khoản 3; điểm đ, điểm e, điểm g, điểm h khoản 4 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K10-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 10 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
d) Thực hiện hành vi quy định tại điểm b khoản 6; điểm đ khoản 8; khoản 9 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 03 tháng đến 05 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K10-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 10 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
đ) Thực hiện hành vi quy định tại điểm c khoản 6 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 10 tháng đến 12 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K10-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 10 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
e) Thực hiện hành vi quy định tại điểm c khoản 7 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 16 tháng đến 18 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D6-K10-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 6 Khoản 10 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 6
g) Thực hiện hành vi quy định tại điểm e, điểm g, điểm h, điểm i khoản 8 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 22 tháng đến 24 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Không chấp hành hiệu lệnh, chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm a, điểm b, điểm c, điểm d, điểm đ, điểm e khoản 2; điểm a, điểm b, điểm c, điểm đ, điểm h, điểm i khoản 3; điểm a, điểm b, điểm c, điểm d, điểm đ, điểm g khoản 4; điểm a, điểm c, điểm đ khoản 5; điểm a, điểm b khoản 6; điểm a khoản 7; điểm a, điểm b khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Chuyển hướng không nhường quyền đi trước cho: Người đi bộ, xe lăn của người khuyết tật qua đường tại nơi có vạch kẻ đường dành cho người đi bộ; xe thô sơ đang đi trên phần đường dành cho xe thô sơ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Chuyển hướng không nhường đường cho: Các xe đi ngược chiều; người đi bộ, xe lăn của người khuyết tật đang qua đường tại nơi không có vạch kẻ đường cho người đi bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Quay đầu xe ở phần đường dành cho người đi bộ qua đường, trên cầu, đầu cầu, ngầm, gầm cầu vượt, trừ trường hợp tổ chức giao thông tại những khu vực này có bố trí nơi quay đầu xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Lùi xe ở đường một chiều, đường có biển "Cấm đi ngược chiều", khu vực cấm dừng, trên phần đường dành cho người đi bộ qua đường, nơi đường bộ giao nhau, nơi đường bộ giao nhau cùng mức với đường sắt, nơi tầm nhìn bị che khuất; lùi xe không quan sát hoặc không có tín hiệu báo trước;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Đỗ, để xe ở hè phố trái quy định của pháp luật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
d) Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường rộng; dừng xe, đỗ xe không sát mép đường phía bên phải theo chiều đi ở nơi đường có lề đường hẹp hoặc không có lề đường; dừng xe, đỗ xe ngược với chiều lưu thông của làn đường; dừng xe, đỗ xe trên dải phân cách cố định ở giữa hai phần đường xe chạy; dừng xe, đỗ xe không đúng vị trí quy định ở những đoạn đường đã có bố trí nơi dừng xe, đỗ xe; đỗ xe trên dốc không chèn bánh; dừng xe nơi có biển "Cấm dừng xe và đỗ xe"; đỗ xe nơi có biển "Cấm đỗ xe" hoặc biển "Cấm dừng xe và đỗ xe", trừ hành vi vi phạm quy định tại điểm a khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
đ) Dừng xe, đỗ xe tại các vị trí: Bên trái đường một chiều hoặc bên trái (theo hướng lưu thông) của đường đôi; trên đoạn đường cong hoặc gần đầu dốc nơi tầm nhìn bị che khuất; trên cầu, gầm cầu vượt, song song với một xe khác đang dừng, đỗ; nơi đường bộ giao nhau hoặc trong phạm vi 05 m tính từ mép đường giao nhau; điểm dừng đón, trả khách của xe buýt; trước cổng hoặc trong phạm vi 05 m hai bên cổng trụ sở cơ quan, tổ chức có bố trí đường cho xe ô tô ra vào; nơi phần đường có bề rộng chỉ đủ cho một làn xe; che khuất biển báo hiệu đường bộ; nơi mở dải phân cách giữa, trừ hành vi vi phạm quy định tại điểm a khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
e) Dừng xe, đỗ xe ở lòng đường đô thị trái quy định; dừng xe, đỗ xe trên đường xe điện, đường dành riêng cho xe buýt, trên miệng cống thoát nước, miệng hầm của đường điện thoại, điện cao thế, các chỗ dành riêng cho xe chữa cháy lấy nước, trên phần đường dành cho người đi bộ qua đường; rời vị trí lái, tắt máy khi dừng xe; mở cửa xe, để cửa xe mở không bảo đảm an toàn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
g) Khi dừng xe, đỗ xe không có tín hiệu báo cho người điều khiển phương tiện khác biết;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K2-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 2 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
h) Khi đỗ xe chiếm một phần đường xe chạy không đặt ngay báo hiệu nguy hiểm theo quy định, trừ hành vi vi phạm quy định tại điểm a khoản 6 Điều này và trường hợp đỗ xe tại vị trí quy định được phép đỗ xe.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Đi vào khu vực cấm, đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, trừ các hành vi vi phạm quy định tại điểm c khoản 4; điểm a khoản 8 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Không đi bên phải theo chiều đi của mình; đi không đúng phần đường hoặc làn đường quy định (làn cùng chiều hoặc làn ngược chiều); điều khiển xe đi qua dải phân cách cố định ở giữa hai phần đường xe chạy, trừ các hành vi vi phạm quy định tại điểm c, điểm d khoản 4; điểm a khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
d) Bấm còi, rú ga liên tục; bấm còi hơi, sử dụng đèn chiếu xa trong đô thị, khu đông dân cư, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
đ) Không nhường đường cho xe đi trên đường ưu tiên, đường chính từ bất kỳ hướng nào tới tại nơi đường giao nhau;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
e) Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 19 giờ ngày hôm trước đến 05 giờ ngày hôm sau, khi sương mù, thời tiết xấu hạn chế tầm nhìn; sử dụng đèn chiếu xa khi tránh xe đi ngược chiều;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
g) Điều khiển xe có liên quan trực tiếp đến vụ tai nạn giao thông mà không dừng lại, không giữ nguyên hiện trường, không tham gia cấp cứu người bị nạn, trừ hành vi vi phạm quy định tại điểm c khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
h) Tránh xe, vượt xe không đúng quy định; không nhường đường cho xe đi ngược chiều theo quy định tại nơi đường hẹp, đường dốc, nơi có chướng ngại vật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K3-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 3 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
i) Điều khiển xe chạy dưới tốc độ tối thiểu trên những đoạn đường bộ có quy định tốc độ tối thiểu cho phép.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Chạy quá tốc độ quy định từ 10 km/h đến 20 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Chạy xe trong hầm đường bộ không sử dụng đèn chiếu sáng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển "Cấm đi ngược chiều", trừ các hành vi vi phạm quy định tại điểm a khoản 8 Điều này và các trường hợp xe ưu tiên đang đi làm nhiệm vụ khẩn cấp theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
d) Không tuân thủ các quy định khi vào hoặc ra đường cao tốc; điều khiển xe chạy ở làn dừng xe khẩn cấp hoặc phần lề đường của đường cao tốc; chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước khi chạy trên đường cao tốc; không tuân thủ quy định về khoảng cách an toàn đối với xe chạy liền trước khi chạy trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K4-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 4 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
đ) Không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt; dừng xe, đỗ xe trong phạm vi an toàn của đường sắt, trừ hành vi vi phạm quy định tại điểm b khoản 2, điểm b khoản 3 Điều 49 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K4-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 4 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
e) Không nhường đường hoặc gây cản trở xe được quyền ưu tiên đang phát tín hiệu ưu tiên đi làm nhiệm vụ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K4-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 4 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
g) Quay đầu xe tại nơi đường bộ giao nhau cùng mức với đường sắt; quay đầu xe tại nơi đường hẹp, đường dốc, đoạn đường cong tầm nhìn bị che khuất, nơi có biển báo "Cấm quay đầu xe".</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Lùi xe, quay đầu xe trong hầm đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Không thực hiện biện pháp bảo đảm an toàn theo quy định khi phương tiện bị hư hỏng trên đoạn đường bộ giao nhau cùng mức với đường sắt;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
d) Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K5-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 5 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
đ) Không chấp hành hiệu lệnh của đèn tín hiệu giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Dừng xe, đỗ xe trên đường cao tốc không đúng nơi quy định; không có báo hiệu để người lái xe khác biết khi buộc phải dừng xe, đỗ xe trên đường cao tốc không đúng nơi quy định; quay đầu xe trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Chạy quá tốc độ quy định trên 20 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Không chú ý quan sát, điều khiển xe chạy quá tốc độ quy định gây tai nạn giao thông; dừng xe, đỗ xe, quay đầu xe, lùi xe, tránh xe, vượt xe, chuyển hướng, chuyển làn đường không đúng quy định gây tai nạn giao thông; không đi đúng phần đường, làn đường, không giữ khoảng cách an toàn giữa hai xe theo quy định gây tai nạn giao thông hoặc đi vào đường có biển báo hiệu có nội dung cấm đi vào đối với loại phương tiện đang điều khiển, đi ngược chiều của đường một chiều, đi ngược chiều trên đường có biển "Cấm đi ngược chiều" gây tai nạn giao thông, trừ các hành vi vi phạm quy định tại điểm a, điểm b khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Lùi xe trên đường cao tốc; đi ngược chiều trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Điều khiển xe máy chuyên dùng có tốc độ thiết kế nhỏ hơn 70 km/h, máy kéo đi vào đường cao tốc, trừ phương tiện, thiết bị phục vụ việc quản lý, bảo trì đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Gây tai nạn giao thông không dừng lại, không giữ nguyên hiện trường, bỏ trốn không đến trình báo với cơ quan có thẩm quyền, không tham gia cấp cứu người bị nạn.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K9-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 9 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K9-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 9 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K9-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 9 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Điều khiển xe trên đường mà trong cơ thể có chất ma túy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K9-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 9 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
d) Không chấp hành yêu cầu kiểm tra về chất ma túy của người thi hành công vụ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K10-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 10 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
a) Thực hiện hành vi quy định tại điểm b, điểm c, điểm g khoản 3; điểm a, điểm c, điểm d, điểm e khoản 4; khoản 5 Điều này bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ (khi điều khiển xe máy chuyên dùng) từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K10-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 10 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
b) Thực hiện hành vi quy định tại điểm a, điểm b khoản 6; điểm a khoản 7 Điều này bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ (khi điều khiển xe máy chuyên dùng) từ 02 tháng đến 04 tháng. Thực hiện hành vi quy định tại một trong các điểm, khoản sau của Điều này mà gây tai nạn giao thông thì bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ (khi điều khiển xe máy chuyên dùng) từ 02 tháng đến 04 tháng: điểm a khoản 1; điểm e, điểm g, điểm h khoản 2; điểm d, điểm đ, điểm e, điểm i khoản 3; điểm b, điểm d, điểm e khoản 4; điểm b, điểm d, điểm đ khoản 5 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K10-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 10 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
c) Thực hiện hành vi quy định tại khoản 8 Điều này thì bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ (khi điều khiển xe máy chuyên dùng) từ 05 tháng đến 07 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K10-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 10 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
d) Thực hiện hành vi quy định tại điểm c khoản 6 Điều này thì bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ (khi điều khiển xe máy chuyên dùng) từ 10 tháng đến 12 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K10-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 10 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
đ) Thực hiện hành vi quy định tại điểm b khoản 7 Điều này thì bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ (khi điều khiển xe máy chuyên dùng) từ 16 tháng đến 18 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D7-K10-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 7 Khoản 10 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
e) Thực hiện hành vi quy định tại khoản 9 bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ (khi điều khiển xe máy chuyên dùng) từ 22 tháng đến 24 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
a) Không đi bên phải theo chiều đi của mình, đi không đúng phần đường quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
b) Dừng xe đột ngột; chuyển hướng không báo hiệu trước;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
c) Không chấp hành hiệu lệnh hoặc chỉ dẫn của biển báo hiệu, vạch kẻ đường, trừ các hành vi vi phạm quy định tại điểm đ khoản 2, điểm c khoản 3 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
d) Vượt bên phải trong các trường hợp không được phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
đ) Dừng xe, đỗ xe trên phần đường xe chạy ở đoạn đường ngoài đô thị nơi có lề đường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
e) Chạy trong hầm đường bộ không có đèn hoặc vật phát sáng báo hiệu; dừng xe, đỗ xe trong hầm đường bộ không đúng nơi quy định; quay đầu xe trong hầm đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
g) Điều khiển xe đạp, xe đạp máy đi dàn hàng ngang từ 03 xe trở lên, xe thô sơ khác đi dàn hàng ngang từ 02 xe trở lên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
h) Người điều khiển xe đạp, xe đạp máy sử dụng ô (dù), điện thoại di động; chở người ngồi trên xe đạp, xe đạp máy sử dụng ô (dù);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
i) Điều khiển xe thô sơ đi ban đêm không có báo hiệu bằng đèn hoặc vật phản quang;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
k) Để xe ở lòng đường đô thị, hè phố trái quy định của pháp luật; đỗ xe ở lòng đường đô thị gây cản trở giao thông, đỗ xe trên đường xe điện, đỗ xe trên cầu gây cản trở giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
l) Không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt, trừ hành vi vi phạm quy định tại điểm b khoản 2, điểm b khoản 3 Điều 49 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
m) Dùng xe đẩy làm quầy hàng lưu động trên đường, gây cản trở giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
n) Không nhường đường cho xe đi trên đường ưu tiên, đường chính từ bất kỳ hướng nào tới tại nơi đường giao nhau;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
o) Xe đạp, xe đạp máy, xe xích lô chở quá số người quy định, trừ trường hợp chở người bệnh đi cấp cứu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
p) Xếp hàng hóa vượt quá giới hạn quy định, không bảo đảm an toàn, gây trở ngại giao thông, che khuất tầm nhìn của người điều khiển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K1-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 1 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
q) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
a) Điều khiển xe đạp, xe đạp máy buông cả hai tay; chuyển hướng đột ngột trước đầu xe cơ giới đang chạy; dùng chân điều khiển xe đạp, xe đạp máy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
b) Không chấp hành hiệu lệnh, chỉ dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
c) Người đang điều khiển xe hoặc chở người ngồi trên xe bám, kéo, đẩy xe khác, vật khác, mang vác vật cồng kềnh; điều khiển xe kéo theo xe khác, vật khác;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
d) Không nhường đường cho xe xin vượt khi có đủ điều kiện an toàn hoặc gây cản trở đối với xe cơ giới xin vượt, gây cản trở xe ưu tiên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
đ) Không chấp hành hiệu lệnh của đèn tín hiệu giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
a) Điều khiển xe lạng lách, đánh võng; đuổi nhau trên đường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
b) Đi xe bằng một bánh đối với xe đạp, xe đạp máy; đi xe bằng hai bánh đối với xe xích lô;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
c) Đi vào khu vực cấm; đường có biển báo hiệu nội dung cấm đi vào đối với loại phương tiện đang điều khiển; đi ngược chiều đường của đường một chiều, đường có biển "Cấm đi ngược chiều";</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
d) Người điều khiển xe đạp máy (kể cả xe đạp điện) không đội "mũ bảo hiểm cho người đi mô tô, xe máy" hoặc đội "mũ bảo hiểm cho người đi mô tô, xe máy" không cài quai đúng quy cách khi tham gia giao thông trên đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
đ) Chở người ngồi trên xe đạp máy (kể cả xe đạp điện) không đội "mũ bảo hiểm cho người đi mô tô, xe máy" hoặc đội "mũ bảo hiểm cho người đi mô tô, xe máy" không cài quai đúng quy cách, trừ trường hợp chở người bệnh đi cấp cứu, trẻ em dưới 06 tuổi, áp giải người có hành vi vi phạm pháp luật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
e) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 50 miligam đến 80 miligam/100 mililít máu hoặc vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
a) Điều khiển xe đi vào đường cao tốc, trừ phương tiện phục vụ việc quản lý, bảo trì đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
b) Gây tai nạn giao thông không dừng lại, không giữ nguyên hiện trường, bỏ trốn không đến trình báo với cơ quan có thẩm quyền, không tham gia cấp cứu người bị nạn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
c) Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn vượt quá 80 miligam/100 mililít máu hoặc vượt quá 0,4 miligam/1 lít khí thở;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
d) Không chấp hành yêu cầu kiểm tra về nồng độ cồn của người thi hành công vụ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D8-K5">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 8 Khoản 5</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
5. Ngoài việc bị phạt tiền, người điều khiển phương tiện tái phạm hoặc vi phạm nhiều lần hành vi quy định tại điểm a, điểm b khoản 3 Điều này còn bị áp dụng hình thức xử phạt bổ sung tịch thu phương tiện.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D9-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 9 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 9
a) Không đi đúng phần đường quy định; vượt qua dải phân cách; đi qua đường không đúng nơi quy định hoặc không bảo đảm an toàn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D9-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 9 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 9
b) Không chấp hành hiệu lệnh hoặc chỉ dẫn của đèn tín hiệu, biển báo hiệu, vạch kẻ đường, trừ hành vi vi phạm quy định tại khoản 2 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D9-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 9 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 9
c) Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D9-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 9 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 9
d) Mang, vác vật cồng kềnh gây cản trở giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D9-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 9 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 9
đ) Đu, bám vào phương tiện giao thông đang chạy.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D9-K2">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 9 Khoản 2</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 9
2. Phạt tiền từ 100.000 đồng đến 200.000 đồng đối với người đi bộ đi vào đường cao tốc, trừ người phục vụ việc quản lý, bảo trì đường cao tốc.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
a) Không nhường đường theo quy định, không báo hiệu bằng tay khi chuyển hướng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
b) Không chấp hành hiệu lệnh hoặc chỉ dẫn của đèn tín hiệu, biển báo hiệu, vạch kẻ đường, trừ hành vi vi phạm quy định tại khoản 3 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
c) Không đủ dụng cụ đựng chất thải của súc vật hoặc không dọn sạch chất thải của súc vật thải ra đường, hè phố;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
d) Điều khiển, dẫn dắt súc vật đi không đúng phần đường quy định, đi vào đường cấm, khu vực cấm, đi vào phần đường của xe cơ giới;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
đ) Để súc vật đi trên đường bộ không bảo đảm an toàn cho người và phương tiện đang tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
e) Đi dàn hàng ngang từ 02 xe trở lên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
g) Để súc vật kéo xe mà không có người điều khiển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K1-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 1 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
h) Điều khiển xe không có báo hiệu theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
a) Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
b) Dắt súc vật chạy theo khi đang điều khiển hoặc ngồi trên phương tiện giao thông đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
c) Xếp hàng hóa trên xe vượt quá giới hạn quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D10-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 10 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 10
3. Phạt tiền từ 400.000 đồng đến 600.000 đồng đối với người điều khiển, dẫn dắt súc vật, điều khiển xe súc vật kéo đi vào đường cao tốc trái quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
1. Phạt tiền từ 80.000 đồng đến 100.000 đồng đối với người được chở trên xe đạp, xe đạp máy sử dụng ô (dù).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
a) Tập trung đông người trái phép, nằm, ngồi trên đường bộ gây cản trở giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
b) Đá bóng, đá cầu, chơi cầu lông hoặc các hoạt động thể thao khác trái phép trên đường bộ; sử dụng bàn trượt, pa-tanh, các thiết bị tương tự trên phần đường xe chạy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
c) Người được chở trên xe mô tô, xe gắn máy (kể cả xe máy điện), các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy sử dụng ô (dù);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
d) Người được chở trên xe đạp, xe đạp máy bám, kéo, đẩy xe khác, vật khác, mang vác vật cồng kềnh.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
3. Phạt tiền từ 200.000 đồng đến 300.000 đồng đối với người được chở trên xe mô tô, xe gắn máy (kể cả xe máy điện), các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy, xe đạp máy (kể cả xe đạp điện) không đội "mũ bảo hiểm cho người đi mô tô, xe máy" hoặc đội "mũ bảo hiểm cho người đi mô tô, xe máy" không cài quai đúng quy cách khi tham gia giao thông trên đường bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
4. Phạt tiền từ 200.000 đồng đến 400.000 đồng đối với cá nhân, từ 400.000 đồng đến 800.000 đồng đối với tổ chức để vật che khuất biển báo, đèn tín hiệu giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K5">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 5</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
5. Phạt tiền từ 300.000 đồng đến 500.000 đồng đối với người được chở trên xe ô tô không thắt dây an toàn (tại vị trí có trang bị dây an toàn) khi xe đang chạy.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K6">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 6</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
6. Phạt tiền từ 400.000 đồng đến 600.000 đồng đối với người được chở trên xe mô tô, xe gắn máy (kể cả xe máy điện), các loại xe tương tự xe mô tô, các loại xe tương tự xe gắn máy bám, kéo, đẩy xe khác, vật khác, dẫn dắt súc vật, mang vác vật cồng kềnh, đứng trên yên, giá đèo hàng hoặc ngồi trên tay lái.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
a) Không cứu giúp người bị tai nạn giao thông khi có yêu cầu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
b) Ném gạch, đất, đá, cát hoặc vật thể khác vào phương tiện đang tham gia giao thông trên đường bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K8">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 8</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
8. Phạt tiền từ 2.000.000 đồng đến 4.000.000 đồng đối với cá nhân, từ 4.000.000 đồng đến 8.000.000 đồng đối với tổ chức cố ý thay đổi, xóa dấu vết hiện trường vụ tai nạn giao thông, trừ các hành vi vi phạm quy định tại điểm đ khoản 2, điểm b khoản 8 Điều 5; điểm e khoản 3, điểm đ khoản 8 Điều 6; điểm g khoản 3, điểm c khoản 8 Điều 7; điểm b khoản 4 Điều 8 Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K9">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 9</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
9. Phạt tiền từ 4.000.000 đồng đến 6.000.000 đồng đối với cá nhân, từ 8.000.000 đồng đến 12.000.000 đồng đối với tổ chức thực hiện hành vi cản trở hoặc không chấp hành yêu cầu thanh tra, kiểm tra, kiểm soát của người thi hành công vụ, trừ các hành vi vi phạm quy định tại khoản 9, điểm b, điểm d khoản 10 Điều 5; điểm g, điểm i khoản 8, khoản 9 Điều 6; điểm b, điểm d khoản 9 Điều 7; điểm d khoản 4 Điều 8; điểm b khoản 6 Điều 33 Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K10-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 10 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
a) Ném đinh, rải đinh hoặc vật sắc nhọn khác, đổ dầu nhờn hoặc các chất gây trơn khác trên đường bộ; chăng dây hoặc các vật cản khác qua đường gây nguy hiểm đến người và phương tiện tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K10-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 10 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
b) Xâm phạm sức khỏe, tài sản của người bị nạn hoặc người gây tai nạn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K10-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 10 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
c) Lợi dụng việc xảy ra tai nạn giao thông để hành hung, đe dọa, xúi giục, gây sức ép, làm mất trật tự, cản trở việc xử lý tai nạn giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K11">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 11</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
11. Ngoài việc bị phạt tiền, cá nhân thực hiện hành vi quy định tại khoản 10 Điều này nếu là người điều khiển phương tiện còn bị áp dụng hình thức xử phạt bổ sung tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K12-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 12 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
a) Thực hiện hành vi quy định tại khoản 4 Điều này buộc phải tháo dỡ các vật che khuất biển báo hiệu đường bộ, đèn tín hiệu giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D11-K12-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 11 Khoản 12 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 11
b) Thực hiện hành vi quy định tại điểm a khoản 10 Điều này buộc phải thu dọn đinh, vật sắc nhọn, dây hoặc các vật cản khác và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra.
Mục 2 VI PHẠM QUY ĐỊNH VỀ KẾT CẤU HẠ TẦNG GIAO THÔNG ĐƯỜNG BỘ</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Bán hàng rong hoặc bán hàng hóa nhỏ lẻ khác trên lòng đường đô thị, trên vỉa hè các tuyến phố có quy định cấm bán hàng, trừ các hành vi vi phạm quy định tại điểm c khoản 2, điểm b khoản 5, điểm e khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Phơi thóc, lúa, rơm, rạ, nông, lâm, hải sản trên đường bộ; đặt máy tuốt lúa trên đường bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Sử dụng, khai thác tạm thời trên đất hành lang an toàn đường bộ vào mục đích canh tác nông nghiệp làm ảnh hưởng đến an toàn công trình đường bộ và an toàn giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Trồng cây trong phạm vi đất dành cho đường bộ làm che khuất tầm nhìn của người điều khiển phương tiện giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
c) Chiếm dụng dải phân cách giữa của đường đôi làm nơi: Bày, bán hàng hóa; để vật liệu xây dựng, trừ các hành vi vi phạm quy định tại điểm b khoản 5; điểm d, điểm e khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
d) Họp chợ, mua, bán hàng hóa trong phạm vi đất của đường bộ ở đoạn đường ngoài đô thị, trừ các hành vi vi phạm quy định tại điểm d khoản 5; điểm d, điểm i khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
đ) Xả nước ra đường bộ không đúng nơi quy định, trừ hành vi vi phạm quy định tại điểm h khoản 6 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Sử dụng đường bộ trái quy định để tổ chức các hoạt động văn hóa, thể thao, diễu hành, lễ hội;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Dựng cổng chào hoặc các vật che chắn khác trái quy định trong phạm vi đất dành cho đường bộ gây ảnh hưởng đến trật tự, an toàn giao thông đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
c) Treo băng rôn, biểu ngữ trái phép trong phạm vi đất dành cho đường bộ gây ảnh hưởng đến trật tự an toàn giao thông đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
d) Đặt, treo biển hiệu, biển quảng cáo trên đất của đường bộ ở đoạn đường ngoài đô thị, trừ các hành vi vi phạm quy định tại điểm b khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
đ) Chiếm dụng dải phân cách giữa của đường đôi làm nơi để xe, trông, giữ xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
e) Sử dụng trái phép đất của đường bộ ở đoạn đường ngoài đô thị làm nơi sửa chữa phương tiện, máy móc, thiết bị; rửa xe, bơm nước mui xe gây ảnh hưởng đến trật tự an toàn giao thông đường bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
4. Phạt tiền từ 1.000.000 đồng đến 2.000.000 đồng đối với cá nhân, từ 2.000.000 đồng đến 4.000.000 đồng đối với tổ chức thực hiện hành vi đổ rác ra đường bộ không đúng nơi quy định, trừ các hành vi vi phạm quy định tại: điểm a khoản 6 Điều này; khoản 3, khoản 4 Điều 20 Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Dựng rạp, lều quán, cổng ra vào, tường rào các loại, công trình khác trái phép trong phạm vi đất dành cho đường bộ, trừ các hành vi vi phạm quy định tại điểm đ khoản 6, điểm b khoản 8, điểm a khoản 9 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Sử dụng trái phép lòng đường đô thị, hè phố để: Họp chợ; kinh doanh dịch vụ ăn uống; bày, bán hàng hóa; sửa chữa phương tiện, máy móc, thiết bị; rửa xe; đặt, treo biển hiệu, biển quảng cáo; xây, đặt bục bệ; làm mái che hoặc thực hiện các hoạt động khác gây cản trở giao thông, trừ các hành vi vi phạm quy định tại điểm d, điểm đ, điểm e, điểm g khoản 6; khoản 7; điểm a khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
c) Chiếm dụng lòng đường đô thị hoặc hè phố dưới 05 m2 làm nơi trông, giữ xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
d) Chiếm dụng phần đường xe chạy hoặc lề đường của đường ngoài đô thị dưới 20 m2 làm nơi trông, giữ xe.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Đổ, để trái phép vật liệu, chất phế thải trong phạm vi đất dành cho đường bộ, trừ các hành vi vi phạm quy định tại khoản 3, khoản 4 Điều 20 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Tự ý đào, đắp, san, lấp mặt bằng trong: Hành lang an toàn đường bộ, phần đất dọc hai bên đường bộ dùng để quản lý, bảo trì, bảo vệ công trình đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
c) Tự ý gắn vào công trình báo hiệu đường bộ các nội dung không liên quan tới ý nghĩa, mục đích của công trình đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
d) Sử dụng trái phép đất của đường bộ hoặc hành lang an toàn đường bộ làm nơi tập kết hoặc trung chuyển hàng hóa, vật tư, vật liệu xây dựng, máy móc, thiết bị, các loại vật dụng khác;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
đ) Dựng rạp, lều quán, công trình khác trái phép trong khu vực đô thị tại hầm đường bộ, cầu vượt, hầm cho người đi bộ, gầm cầu vượt, trừ hành vi vi phạm quy định tại điểm a khoản 9 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
e) Bày, bán máy móc, thiết bị, vật tư, vật liệu xây dựng hoặc sản xuất, gia công hàng hóa trên lòng đường đô thị, hè phố;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
g) Chiếm dụng lòng đường đô thị hoặc hè phố từ 05 m2 đến dưới 10 m2 làm nơi trông, giữ xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
h) Xả nước thải xây dựng từ các công trình xây dựng ra đường phố;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K6-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 6 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
i) Chiếm dụng phần đường xe chạy hoặc lề đường của đường ngoài đô thị từ 20 m2 trở lên làm nơi trông, giữ xe.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K7">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 7</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
7. Phạt tiền từ 6.000.000 đồng đến 8.000.000 đồng đối với cá nhân, từ 12.000.000 đồng đến 16.000.000 đồng đối với tổ chức thực hiện hành vi chiếm dụng lòng đường đô thị hoặc hè phố từ 10 m2 đến dưới 20 m2 làm nơi trông, giữ xe.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Chiếm dụng lòng đường đô thị hoặc hè phố từ 20 m2 trở lên làm nơi trông, giữ xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Dựng biển quảng cáo trên đất hành lang an toàn đường bộ khi chưa được cơ quan quản lý đường bộ có thẩm quyền đồng ý bằng văn bản hoặc dựng biển quảng cáo trên phần đất dọc hai bên đường bộ dùng để quản lý, bảo trì, bảo vệ công trình đường bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K9-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 9 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Chiếm dụng đất của đường bộ hoặc đất hành lang an toàn đường bộ để xây dựng nhà ở;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K9-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 9 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Mở đường nhánh đấu nối trái phép vào đường chính.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K10-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 10 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
a) Thực hiện hành vi quy định tại điểm b khoản 1 Điều này buộc phải thu dọn thóc, lúa, rơm, rạ, nông, lâm, hải sản, thiết bị trên đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K10-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 10 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
b) Thực hiện hành vi quy định tại điểm a, điểm b khoản 2 Điều này buộc phải di dời cây trồng không đúng quy định và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K10-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 10 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
c) Thực hiện hành vi quy định tại điểm c, điểm d khoản 2 Điều này buộc phải thu dọn vật tư, vật liệu, hàng hóa và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K10-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 10 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
d) Thực hiện hành vi quy định tại khoản 3; khoản 4; điểm b, điểm c, điểm d khoản 5; điểm a, điểm b, điểm c, điểm d, điểm e, điểm g, điểm h, điểm i khoản 6; khoản 7; điểm a khoản 8 Điều này buộc phải thu dọn rác, chất phế thải, phương tiện, vật tư, vật liệu, hàng hóa, máy móc, thiết bị, biển hiệu, biển quảng cáo, các loại vật dụng khác và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D12-K10-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 12 Khoản 10 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12
đ) Thực hiện hành vi quy định tại điểm a khoản 5, điểm đ khoản 6, điểm b khoản 8, khoản 9 Điều này buộc phải tháo dỡ công trình xây dựng trái phép (không có giấy phép hoặc không đúng với giấy phép) và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
1. Cảnh cáo hoặc phạt tiền từ 250.000 đồng đến 500.000 đồng đối với cá nhân, từ 500.000 đồng đến 1.000.000 đồng đối với tổ chức thực hiện hành vi thi công trên đường bộ đang khai thác không treo biển báo thông tin công trình hoặc treo biển báo thông tin không đầy đủ nội dung theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
a) Thi công công trình trong phạm vi đất dành cho đường bộ không thực hiện theo đúng các quy định trong Giấy phép thi công hoặc trong văn bản thỏa thuận thi công của cơ quan có thẩm quyền, trừ các hành vi vi phạm quy định tại khoản 3, điểm a khoản 4, khoản 5 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
b) Không bố trí người hướng dẫn, điều khiển giao thông khi thi công ở chỗ đường hẹp hoặc ở hai đầu cầu, cống, đường ngầm đang thi công theo đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
c) Để vật liệu, đất đá, phương tiện thi công ngoài phạm vi thi công gây cản trở giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
d) Không thu dọn ngay các biển báo hiệu, rào chắn, phương tiện, vật dụng thi công, các vật liệu khác hoặc không hoàn trả phần đường (gồm lòng đường, lề đường, hè phố), phần đất dọc hai bên đường bộ dùng để quản lý, bảo trì, bảo vệ công trình đường bộ, hành lang an toàn đường bộ theo nguyên trạng khi thi công xong.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
a) Thi công công trình trong phạm vi đất dành cho đường bộ có Giấy phép thi công nhưng đã hết thời hạn ghi trong Giấy phép hoặc có văn bản thỏa thuận thi công của cơ quan có thẩm quyền nhưng đã hết thời hạn thi công ghi trong văn bản;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
b) Thi công trên đường bộ đang khai thác không có biện pháp bảo đảm an toàn giao thông thông suốt để xảy ra ùn tắc giao thông nghiêm trọng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
a) Thi công trên đường bộ đang khai thác có bố trí biển báo hiệu, cọc tiêu di động, rào chắn nhưng không đầy đủ theo quy định; không đặt đèn đỏ vào ban đêm tại hai đầu đoạn đường thi công;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
b) Thi công công trình trong phạm vi đất dành cho đường bộ không có Giấy phép thi công hoặc không có văn bản thỏa thuận thi công của cơ quan có thẩm quyền theo quy định, trừ các hành vi vi phạm quy định tại điểm a khoản 3 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
a) Thi công công trình trên đường đô thị không thực hiện theo phương án thi công hoặc thời gian quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
b) Thi công trên đường bộ đang khai thác không thực hiện đầy đủ các biện pháp bảo đảm an toàn giao thông theo quy định để xảy ra tai nạn giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
c) Thi công trên đường bộ đang khai thác không bố trí biển báo hiệu, cọc tiêu di động, rào chắn theo quy định, trừ các hành vi vi phạm quy định tại điểm a khoản 4 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K6">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 6</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
6. Ngoài việc bị phạt tiền, cá nhân, tổ chức thực hiện hành vi vi phạm quy định tại điểm a khoản 2, điểm b khoản 3, điểm c khoản 5 Điều này còn bị áp dụng hình thức xử phạt bổ sung đình chỉ hoạt động thi công hoặc tước quyền sử dụng Giấy phép thi công (nếu có) từ 01 tháng đến 03 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
a) Thực hiện hành vi quy định tại khoản 1 Điều này buộc phải treo biển báo thông tin công trình có đầy đủ nội dung theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
b) Thực hiện hành vi quy định tại điểm a, điểm b khoản 2; khoản 3; điểm a khoản 4; khoản 5 Điều này buộc phải thực hiện ngay các biện pháp bảo đảm an toàn giao thông theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D13-K7-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 13 Khoản 7 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 13
c) Thực hiện hành vi quy định tại điểm c, điểm d khoản 2; điểm b khoản 4 Điều này buộc phải thực hiện ngay các biện pháp bảo đảm an toàn giao thông theo quy định và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D14-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 14 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 14
a) Xây dựng hoặc thành lập bến xe, bãi đỗ xe, trạm dừng nghỉ, trạm thu phí đường bộ khi chưa được cơ quan quản lý nhà nước về giao thông vận tải đồng ý theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D14-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 14 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 14
b) Xây dựng bến xe, bãi đỗ xe, trạm dừng nghỉ, trạm thu phí đường bộ không bảo đảm tiêu chuẩn kỹ thuật theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D14-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 14 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 14
a) Thực hiện hành vi quy định tại điểm a khoản 1 Điều này còn buộc phải tháo dỡ công trình xây dựng trái phép và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D14-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 14 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 14
b) Thực hiện hành vi quy định tại điểm b khoản 1 Điều này còn buộc phải xây dựng lại bến xe, bãi đỗ xe, trạm dừng nghỉ, trạm thu phí đường bộ theo đúng quy định, bảo đảm tiêu chuẩn kỹ thuật.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Chăn dắt súc vật ở mái đường; buộc súc vật vào hàng cây hai bên đường hoặc vào cọc tiêu, biển báo, rào chắn, các công trình phụ trợ của giao thông đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Tự ý leo trèo lên mố, trụ, dầm cầu.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Tự ý đốt lửa trên cầu, dưới gầm cầu; neo đậu tàu, thuyền dưới gầm cầu hoặc trong phạm vi hành lang an toàn cầu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Tự ý be bờ, tát nước qua mặt đường giao thông; đặt ống bơm nước, bơm cát qua đường, đốt lửa trên mặt đường.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Không bổ sung hoặc sửa chữa kịp thời theo quy định các biển báo hiệu nguy hiểm đã bị mất, bị hư hỏng mất tác dụng; không có biện pháp khắc phục kịp thời theo quy định các hư hỏng của công trình đường bộ gây mất an toàn giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Không phát hiện hoặc không có biện pháp ngăn chặn, báo cáo kịp thời các hành vi lấn chiếm, sử dụng trái phép hành lang an toàn giao thông đường bộ, phần đất dọc hai bên đường bộ dùng để quản lý, bảo trì, bảo vệ công trình đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
c) Không cắm cột thủy chí và có biện pháp ngăn chặn phương tiện qua những đoạn đường bị ngập nước sâu trên 0,2 m;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
d) Không có quy trình quản lý, vận hành, khai thác, bảo trì đường bộ theo quy định hoặc không thực hiện đầy đủ các nội dung quy định trong quy trình quản lý, vận hành, khai thác, bảo trì đường bộ đã được phê duyệt.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Di chuyển chậm trễ các công trình, nhà, lều quán xây dựng trái phép hoặc cố tình trì hoãn việc di chuyển gây cản trở cho việc giải phóng mặt bằng để xây dựng, cải tạo, mở rộng và bảo vệ công trình đường bộ khi có quyết định của cơ quan nhà nước có thẩm quyền;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Làm hư hỏng hoặc làm mất tác dụng của hệ thống thoát nước công trình đường bộ, trừ các hành vi vi phạm quy định tại khoản 5 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
c) Tự ý tháo dỡ, di chuyển, treo, đặt, làm hư hỏng, làm sai mục đích sử dụng hoặc làm sai lệch biển báo hiệu, đèn tín hiệu giao thông, rào chắn, cọc tiêu, cột cây số, vạch kẻ đường, tường bảo vệ, lan can phòng hộ, mốc chỉ giới;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
d) Tự ý đập phá, tháo dỡ bó vỉa hè hoặc sửa chữa, cải tạo vỉa hè trái phép, trừ các hành vi vi phạm quy định tại điểm a, điểm c khoản 5 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Khoan, đào, xẻ đường, hè phố trái phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Phá dỡ trái phép dải phân cách, gương cầu, các công trình, thiết bị an toàn giao thông trên đường bộ, cấu kiện, phụ kiện của công trình đường bộ, trừ các hành vi vi phạm quy định tại điểm c khoản 4 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
c) Tự ý tháo, mở làm hư hỏng nắp cống, nắp ga các công trình ngầm, hệ thống tuy nen trên đường giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
d) Nổ mìn hoặc khai thác đất, cát, đá, sỏi, khoáng sản khác trái phép làm ảnh hưởng đến công trình đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K5-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 5 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
đ) Rải, đổ hóa chất gây hư hỏng công trình đường bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Không thực hiện đúng quy trình quản lý, vận hành theo quy định để số lượng xe ô tô xếp hàng chờ trước trạm thu phí trên một làn xe chờ dài nhất lớn hơn 100 xe đến 150 xe hoặc để chiều dài dòng xe xếp hàng chờ trước trạm thu phí (tính từ cabin thu phí đến xe cuối cùng của hàng xe chờ) từ 750 m đến 1.000 m;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Không thực hiện đúng quy trình quản lý, vận hành theo quy định để thời gian đi qua trạm thu phí của một xe ô tô bất kỳ kể từ lúc dừng xe chờ thu phí đến lúc ra khỏi trạm thu phí lớn hơn 10 phút đến 20 phút.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Không thực hiện đúng quy trình quản lý, vận hành theo quy định để số lượng xe ô tô xếp hàng chờ trước trạm thu phí trên một làn xe chờ dài nhất lớn hơn 150 xe đến 200 xe hoặc để chiều dài dòng xe xếp hàng chờ trước trạm thu phí (tính từ cabin thu phí đến xe cuối cùng của hàng xe chờ) lớn hơn 1.000 m đến 2.000 m;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Không thực hiện đúng quy trình quản lý, vận hành theo quy định để thời gian đi qua trạm thu phí của một xe ô tô bất kỳ kể từ lúc dừng xe chờ thu phí đến lúc ra khỏi trạm thu phí lớn hơn 20 phút đến 30 phút.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Không thực hiện đúng quy trình quản lý, vận hành theo quy định để số lượng xe ô tô xếp hàng chờ trước trạm thu phí trên một làn xe chờ dài nhất lớn hơn 200 xe hoặc để chiều dài dòng xe xếp hàng chờ trước trạm thu phí (tính từ cabin thu phí đến xe cuối cùng của hàng xe chờ) lớn hơn 2.000 m;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Không thực hiện đúng quy trình quản lý, vận hành theo quy định để thời gian đi qua trạm thu phí của một xe ô tô bất kỳ kể từ lúc dừng xe chờ thu phí đến lúc ra khỏi trạm thu phí lớn hơn 30 phút.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K9-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 9 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Vi phạm khoản 6, khoản 7, khoản 8 Điều này mà không chấp hành yêu cầu của cơ quan quản lý nhà nước có thẩm quyền về việc triển khai các giải pháp để khắc phục ùn tắc giao thông tại khu vực trạm thu phí;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K9-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 9 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Không thực hiện việc kết nối, chia sẻ dữ liệu từ trạm thu phí cho cơ quan quản lý nhà nước có thẩm quyền theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K10-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 10 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
a) Thực hiện hành vi quy định tại điểm a khoản 3 Điều này buộc phải bổ sung hoặc sửa chữa các biển báo hiệu bị mất, bị hư hỏng và khắc phục các hư hỏng của công trình đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D15-K10-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 15 Khoản 10 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 15
b) Thực hiện hành vi quy định tại điểm b khoản 2; điểm b, điểm c, điểm d khoản 4; khoản 5 Điều này buộc phải khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra.
Mục 3 VI PHẠM QUY ĐỊNH VỀ PHƯƠNG TIỆN THAM GIA GIAO THÔNG ĐƯỜNG BỘ</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
1. Phạt tiền từ 100.000 đồng đến 200.000 đồng đối với hành vi điều khiển xe không có kính chắn gió hoặc có nhưng vỡ hoặc có nhưng không có tác dụng (đối với xe có thiết kế lắp kính chắn gió).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
a) Điều khiển xe không có đủ đèn chiếu sáng, đèn soi biển số, đèn báo hãm, đèn tín hiệu, cần gạt nước, gương chiếu hậu, dây an toàn, dụng cụ thoát hiểm, thiết bị chữa cháy, đồng hồ báo áp lực hơi, đồng hồ báo tốc độ của xe hoặc có những thiết bị đó nhưng không có tác dụng, không đúng tiêu chuẩn thiết kế (đối với loại xe được quy định phải có những thiết bị đó), trừ các hành vi vi phạm quy định tại điểm m khoản 3 Điều 23, điểm q khoản 4 Điều 28 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
b) Điều khiển xe không có còi hoặc có nhưng còi không có tác dụng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
c) Điều khiển xe không có bộ phận giảm thanh, giảm khói hoặc có nhưng không có tác dụng, không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
a) Điều khiển xe lắp thêm đèn phía trước, phía sau, trên nóc, dưới gầm, một hoặc cả hai bên thành xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
b) Điều khiển xe có hệ thống chuyển hướng của xe không đúng tiêu chuẩn an toàn kỹ thuật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
c) Điều khiển xe không gắn đủ biển số hoặc gắn biển số không đúng vị trí; gắn biển số không rõ chữ, số; gắn biển số bị bẻ cong, bị che lấp, bị hỏng; sơn, dán thêm làm thay đổi chữ, số hoặc thay đổi màu sắc của chữ, số, nền biển (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
d) Điều khiển xe không lắp đủ bánh lốp hoặc lắp bánh lốp không đúng kích cỡ hoặc không bảo đảm tiêu chuẩn kỹ thuật (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
đ) Điều khiển xe ô tô tải có kích thước thùng xe không đúng thiết kế của nhà sản xuất hoặc thiết kế đã đăng ký với cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
e) Điều khiển xe ô tô kinh doanh vận tải hành khách lắp thêm hoặc tháo bớt ghế, giường nằm hoặc có kích thước khoang chở hành lý (hầm xe) không đúng thiết kế của nhà sản xuất hoặc thiết kế đã đăng ký với cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
a) Điều khiển xe không có Giấy đăng ký xe theo quy định hoặc sử dụng Giấy đăng ký xe đã hết hạn sử dụng (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
b) Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
c) Điều khiển xe có Giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hạn sử dụng dưới 01 tháng (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
d) Điều khiển xe lắp đặt, sử dụng còi vượt quá âm lượng theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K4-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 4 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
đ) Điều khiển xe không đủ hệ thống hãm hoặc có đủ hệ thống hãm nhưng không có tác dụng, không đúng tiêu chuẩn an toàn kỹ thuật.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
a) Điều khiển xe đăng ký tạm, xe có phạm vi hoạt động hạn chế hoạt động quá phạm vi, thời hạn cho phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
b) Điều khiển xe quá niên hạn sử dụng tham gia giao thông (đối với loại xe có quy định về niên hạn sử dụng);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
c) Điều khiển loại xe sản xuất, lắp ráp trái quy định tham gia giao thông (bao gồm cả xe công nông thuộc diện bị đình chỉ tham gia giao thông);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
d) Điều khiển xe gắn biển số không đúng với Giấy đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K5-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 5 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
đ) Sử dụng Giấy đăng ký xe, Giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa; sử dụng Giấy đăng ký xe không đúng số khung, số máy của xe (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K5-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 5 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
e) Điều khiển xe không có Giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định, trừ xe đăng ký tạm thời) hoặc có nhưng đã hết hạn sử dụng từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
a) Thực hiện hành vi quy định tại điểm a, điểm b khoản 3; khoản 4; điểm a, điểm e khoản 5 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
b) Thực hiện hành vi quy định tại điểm a khoản 3, điểm d khoản 4 Điều này bị tịch thu đèn lắp thêm, còi vượt quá âm lượng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
c) Thực hiện hành vi quy định tại điểm d, điểm đ khoản 5 Điều này bị tịch thu Giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường, Giấy đăng ký xe, biển số không đúng quy định hoặc bị tẩy xóa; bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K6-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 6 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
d) Thực hiện hành vi quy định tại điểm b, điểm c khoản 5 Điều này bị tịch thu phương tiện (trừ trường hợp xe ô tô từ 10 chỗ ngồi trở lên kinh doanh vận tải hành khách có niên hạn sử dụng vượt quá quy định về điều kiện kinh doanh của hình thức kinh doanh đã đăng ký nhưng chưa quá 20 năm tính từ năm sản xuất, xe ô tô dưới 10 chỗ ngồi kinh doanh vận tải hành khách) và bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K6-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 6 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
đ) Thực hiện hành vi quy định tại điểm a khoản 4, điểm đ khoản 5 Điều này trong trường hợp không có Giấy đăng ký xe hoặc sử dụng Giấy đăng ký xe không do cơ quan có thẩm quyền cấp, không đúng số khung, số máy của xe hoặc bị tẩy xóa (kể cả rơ moóc và sơ mi rơ moóc) mà không chứng minh được nguồn gốc xuất xứ của phương tiện (không có giấy tờ, chứng từ chuyển quyền sở hữu xe hoặc giấy tờ, chứng từ nguồn gốc xe hợp pháp) thì bị tịch thu phương tiện.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
a) Thực hiện hành vi quy định tại khoản 1; khoản 2; điểm b, điểm c, điểm d, điểm đ khoản 3; điểm d, điểm đ khoản 4 Điều này buộc phải lắp đầy đủ thiết bị hoặc thay thế thiết bị đủ tiêu chuẩn an toàn kỹ thuật hoặc khôi phục lại tính năng kỹ thuật của thiết bị theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D16-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 16 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16
b) Thực hiện hành vi quy định tại điểm a, điểm e khoản 3 Điều này buộc phải lắp đầy đủ thiết bị hoặc khôi phục lại tính năng kỹ thuật của thiết bị theo quy định, tháo bỏ những thiết bị lắp thêm không đúng quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
a) Điều khiển xe không có còi; đèn soi biển số; đèn báo hãm; gương chiếu hậu bên trái người điều khiển hoặc có nhưng không có tác dụng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
b) Điều khiển xe gắn biển số không đúng quy định; gắn biển số không rõ chữ, số; gắn biển số bị bẻ cong, bị che lấp, bị hỏng; sơn, dán thêm làm thay đổi chữ, số hoặc thay đổi màu sắc của chữ, số, nền biển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
c) Điều khiển xe không có đèn tín hiệu hoặc có nhưng không có tác dụng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
d) Sử dụng còi không đúng quy chuẩn kỹ thuật cho từng loại xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
đ) Điều khiển xe không có bộ phận giảm thanh, giảm khói hoặc có nhưng không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
e) Điều khiển xe không có đèn chiếu sáng gần, xa hoặc có nhưng không có tác dụng, không đúng tiêu chuẩn thiết kế;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
g) Điều khiển xe không có hệ thống hãm hoặc có nhưng không có tác dụng, không bảo đảm tiêu chuẩn kỹ thuật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K1-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 1 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
h) Điều khiển xe lắp đèn chiếu sáng về phía sau xe.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
a) Điều khiển xe không có Giấy đăng ký xe theo quy định hoặc sử dụng Giấy đăng ký xe đã hết hạn sử dụng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
b) Sử dụng Giấy đăng ký xe đã bị tẩy xóa; sử dụng Giấy đăng ký xe không đúng số khung, số máy của xe hoặc không do cơ quan có thẩm quyền cấp;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
c) Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số); gắn biển số không đúng với Giấy đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
a) Điều khiển xe đăng ký tạm hoạt động quá phạm vi, thời hạn cho phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
b) Điều khiển loại xe sản xuất, lắp ráp trái quy định tham gia giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
a) Thực hiện hành vi quy định tại điểm d khoản 1 Điều này bị tịch thu còi;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
b) Thực hiện hành vi quy định tại điểm b, điểm c khoản 2 Điều này bị tịch thu Giấy đăng ký xe, biển số không đúng quy định hoặc bị tẩy xóa;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
c) Thực hiện hành vi quy định tại điểm a khoản 3 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
d) Thực hiện hành vi quy định tại điểm b khoản 3 Điều này bị tịch thu phương tiện và tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D17-K4-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 17 Khoản 4 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 17
đ) Thực hiện hành vi quy định tại điểm a, điểm b khoản 2 Điều này trong trường hợp không có Giấy đăng ký xe hoặc sử dụng Giấy đăng ký xe không do cơ quan có thẩm quyền cấp, không đúng số khung, số máy của xe hoặc bị tẩy xóa mà không chứng minh được nguồn gốc xuất xứ của phương tiện (không có giấy tờ, chứng từ chuyển quyền sở hữu xe hoặc giấy tờ, chứng từ nguồn gốc xe hợp pháp) thì bị tịch thu phương tiện.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D18-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 18 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 18
1. Phạt tiền từ 100.000 đồng đến 200.000 đồng đối với hành vi điều khiển xe không có đăng ký, không gắn biển số (đối với loại xe có quy định phải đăng ký và gắn biển số).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D18-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 18 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 18
a) Điều khiển xe không có hệ thống hãm hoặc có nhưng không có tác dụng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D18-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 18 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 18
b) Điều khiển xe thô sơ chở khách, chở hàng không bảo đảm tiêu chuẩn về tiện nghi và vệ sinh theo quy định của địa phương.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
a) Điều khiển xe gắn biển số không đúng vị trí; gắn biển số không rõ chữ, số; gắn biển số bị bẻ cong, bị che lấp, bị hỏng; sơn, dán thêm làm thay đổi chữ, số hoặc thay đổi màu sắc của chữ, số, nền biển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
b) Điều khiển xe không có hệ thống hãm hoặc có hệ thống hãm nhưng không bảo đảm tiêu chuẩn kỹ thuật; điều khiển xe có hệ thống chuyển hướng không bảo đảm tiêu chuẩn kỹ thuật;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
c) Điều khiển xe có các bộ phận chuyên dùng lắp đặt không đúng vị trí; không bảo đảm an toàn khi di chuyển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
d) Điều khiển xe không có đủ đèn chiếu sáng; không có bộ phận giảm thanh, giảm khói hoặc có nhưng không có tác dụng, không bảo đảm quy chuẩn môi trường về khí thải, tiếng ồn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K1-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 1 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
đ) Điều khiển xe có Giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường nhưng đã hết hạn sử dụng dưới 01 tháng (kể cả rơ moóc).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
a) Điều khiển xe hoạt động không đúng phạm vi quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
b) Điều khiển máy kéo, xe máy chuyên dùng sản xuất, lắp ráp hoặc cải tạo trái quy định tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
c) Điều khiển xe không có Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định, trừ xe đăng ký tạm thời) hoặc có nhưng đã hết hạn sử dụng từ 01 tháng trở lên (kể cả rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
d) Điều khiển xe không có Giấy đăng ký xe hoặc sử dụng Giấy đăng ký xe đã hết hạn sử dụng (kể cả rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
đ) Điều khiển xe không gắn biển số (đối với loại xe có quy định phải gắn biển số); gắn biển số không đúng với Giấy đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp (kể cả rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
e) Sử dụng Giấy đăng ký xe, Giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa; sử dụng Giấy đăng ký xe không đúng số khung, số máy của xe (kể cả rơ moóc).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
a) Thực hiện hành vi quy định tại điểm b khoản 2 Điều này bị tịch thu phương tiện;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
b) Thực hiện hành vi quy định tại điểm đ khoản 1; điểm b, điểm c, điểm d, điểm đ, điểm e khoản 2 Điều này bị tước quyền sử dụng Giấy phép lái xe (khi điều khiển máy kéo), chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ khi điều khiển xe máy chuyên dùng) từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
c) Thực hiện hành vi quy định tại điểm đ, điểm e khoản 2 Điều này bị tịch thu Giấy đăng ký xe, biển số, Giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường không đúng quy định hoặc bị tẩy xóa;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
d) Thực hiện hành vi quy định tại điểm d, điểm e khoản 2 Điều này trong trường hợp không có Giấy đăng ký xe hoặc sử dụng Giấy đăng ký xe không do cơ quan có thẩm quyền cấp, không đúng số khung, số máy của xe hoặc bị tẩy xóa (kể cả rơ moóc) mà không chứng minh được nguồn gốc xuất xứ của phương tiện (không có giấy tờ, chứng từ chuyển quyền sở hữu xe hoặc giấy tờ, chứng từ nguồn gốc xe hợp pháp) thì bị tịch thu phương tiện.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D19-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 19 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 19
4. Ngoài việc bị áp dụng hình thức xử phạt, người điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b, điểm c, điểm d khoản 1 Điều này còn bị áp dụng biện pháp khắc phục hậu quả: Buộc phải lắp đầy đủ thiết bị hoặc thay thế thiết bị đủ tiêu chuẩn an toàn kỹ thuật hoặc khôi phục lại tính năng kỹ thuật của thiết bị theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
1. Phạt tiền từ 100.000 đồng đến 200.000 đồng đối với hành vi điều khiển xe không đáp ứng yêu cầu về vệ sinh lưu thông trong đô thị.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
a) Để dầu nhờn, hóa chất rơi vãi xuống đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
b) Chở hàng rời, chất thải, vật liệu xây dựng dễ rơi vãi mà không có mui, bạt che đậy hoặc có mui, bạt che đậy nhưng vẫn để rơi vãi; chở hàng hoặc chất thải để nước chảy xuống mặt đường gây mất an toàn giao thông và vệ sinh môi trường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
c) Lôi kéo bùn, đất, cát, nguyên liệu, vật liệu hoặc chất phế thải khác ra đường bộ gây mất an toàn giao thông và vệ sinh môi trường.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
3. Phạt tiền từ 4.000.000 đồng đến 6.000.000 đồng đối với người điều khiển xe đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải trong phạm vi đất dành cho đường bộ ở đoạn đường ngoài đô thị.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
4. Phạt tiền từ 10.000.000 đồng đến 15.000.000 đồng đối với người điều khiển xe thực hiện hành vi đổ trái phép rác, đất, cát, đá, vật liệu, chất phế thải ra đường phố.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K5">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 5</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
5. Ngoài việc bị phạt tiền, người điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 3, khoản 4 Điều này còn bị áp dụng hình thức xử phạt bổ sung tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D20-K6">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 20 Khoản 6</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 20
6. Ngoài việc bị áp dụng hình thức xử phạt, người điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 2, khoản 3, khoản 4 Điều này còn bị áp dụng các biện pháp khắc phục hậu quả: Buộc phải thu dọn rác, chất phế thải, vật liệu, hàng hóa và khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra; nếu gây ô nhiễm môi trường phải thực hiện các biện pháp khắc phục tình trạng ô nhiễm môi trường do vi phạm hành chính gây ra.
Mục 4 VI PHẠM QUY ĐỊNH VỀ NGƯỜI ĐIỀU KHIỂN PHƯƠNG TIỆN THAM GIA GIAO THÔNG ĐƯỜNG BỘ</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
1. Phạt cảnh cáo người từ đủ 14 tuổi đến dưới 16 tuổi điều khiển xe mô tô, xe gắn máy (kể cả xe máy điện) và các loại xe tương tự xe mô tô hoặc điều khiển xe ô tô, máy kéo và các loại xe tương tự xe ô tô.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
a) Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy không có hoặc không mang theo Giấy chứng nhận bảo hiểm trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
b) Người điều khiển xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô và các loại xe tương tự xe gắn máy không mang theo Giấy đăng ký xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
c) Người điều khiển xe mô tô và các loại xe tương tự xe mô tô không mang theo Giấy phép lái xe, trừ hành vi vi phạm quy định tại điểm b khoản 5, điểm c khoản 7 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
a) Người điều khiển xe ô tô, máy kéo và các loại xe tương tự xe ô tô không mang theo Giấy phép lái xe, trừ hành vi vi phạm quy định tại điểm c khoản 8 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
b) Người điều khiển xe ô tô, máy kéo và các loại xe tương tự xe ô tô không mang theo Giấy đăng ký xe (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
c) Người điều khiển xe ô tô, máy kéo và các loại xe tương tự xe ô tô không mang theo Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định, kể cả rơ moóc và sơ mi rơ moóc).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
a) Người từ đủ 16 tuổi đến dưới 18 tuổi điều khiển xe mô tô có dung tích xi lanh từ 50 cm3 trở lên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
b) Người điều khiển xe ô tô, máy kéo và các loại xe tương tự xe ô tô không có hoặc không mang theo Giấy chứng nhận bảo hiểm trách nhiệm dân sự của chủ xe cơ giới còn hiệu lực;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
c) Người điều khiển xe ô tô, máy kéo và các loại xe tương tự xe ô tô có Giấy phép lái xe nhưng đã hết hạn sử dụng dưới 06 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
a) Không có Giấy phép lái xe hoặc sử dụng Giấy phép lái xe không do cơ quan có thẩm quyền cấp, Giấy phép lái xe bị tẩy xóa;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
b) Có Giấy phép lái xe quốc tế do các nước tham gia Công ước về Giao thông đường bộ năm 1968 cấp (trừ Giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo Giấy phép lái xe quốc gia;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
c) Sử dụng Giấy phép lái xe không hợp lệ (Giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý Giấy phép lái xe).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K6">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 6</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
6. Phạt tiền từ 1.200.000 đồng đến 3.000.000 đồng đối với người từ đủ 16 tuổi đến dưới 18 tuổi điều khiển xe ô tô, máy kéo, các loại xe tương tự xe ô tô.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
a) Có Giấy phép lái xe nhưng không phù hợp với loại xe đang điều khiển;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
b) Không có Giấy phép lái xe hoặc sử dụng Giấy phép lái xe không do cơ quan có thẩm quyền cấp, Giấy phép lái xe bị tẩy xóa;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K7-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 7 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
c) Có Giấy phép lái xe quốc tế do các nước tham gia Công ước về Giao thông đường bộ năm 1968 cấp (trừ Giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo Giấy phép lái xe quốc gia;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K7-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 7 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
d) Sử dụng Giấy phép lái xe không hợp lệ (Giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý Giấy phép lái xe).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
a) Có Giấy phép lái xe nhưng không phù hợp với loại xe đang điều khiển hoặc đã hết hạn sử dụng từ 06 tháng trở lên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
b) Không có Giấy phép lái xe hoặc sử dụng Giấy phép lái xe không do cơ quan có thẩm quyền cấp, Giấy phép lái xe bị tẩy xóa;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
c) Có Giấy phép lái xe quốc tế do các nước tham gia Công ước về Giao thông đường bộ năm 1968 cấp (trừ Giấy phép lái xe quốc tế do Việt Nam cấp) nhưng không mang theo Giấy phép lái xe quốc gia;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K8-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 8 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
d) Sử dụng Giấy phép lái xe không hợp lệ (Giấy phép lái xe có số phôi ghi ở mặt sau không trùng với số phôi được cấp mới nhất trong hệ thống thông tin quản lý Giấy phép lái xe).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K9-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 9 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
a) Thực hiện hành vi quy định tại điểm a, điểm c khoản 5; điểm b, điểm d khoản 7; điểm b, điểm d khoản 8 Điều này còn bị áp dụng hình thức xử phạt bổ sung tịch thu Giấy phép lái xe không do cơ quan có thẩm quyền cấp, Giấy phép lái xe bị tẩy xóa, Giấy phép lái xe không hợp lệ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D21-K9-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 21 Khoản 9 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 21
b) Thực hiện hành vi quy định tại điểm c khoản 5, điểm d khoản 7, điểm d khoản 8 bị tước quyền sử dụng Giấy phép lái xe được cấp mới nhất trong hệ thống thông tin quản lý Giấy phép lái xe từ 01 tháng đến 03 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D22-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 22 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 22
a) Người điều khiển xe máy chuyên dùng không đúng độ tuổi hoặc tuổi không phù hợp với ngành nghề theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D22-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 22 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 22
b) Người điều khiển xe máy chuyên dùng không mang theo bằng (hoặc chứng chỉ) điều khiển, chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D22-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 22 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 22
c) Người điều khiển xe máy chuyên dùng không mang theo Giấy đăng ký xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D22-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 22 Khoản 1 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 22
d) Người điều khiển xe máy chuyên dùng không mang theo Giấy chứng nhận an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D22-K2">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 22 Khoản 2</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 22
2. Phạt tiền từ 600.000 đồng đến 1.000.000 đồng đối với người điều khiển xe máy chuyên dùng không có bằng (hoặc chứng chỉ) điều khiển, chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ.
Mục 5 VI PHẠM QUY ĐỊNH VỀ VẬN TẢI ĐƯỜNG BỘ</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
a) Không hướng dẫn hành khách đứng, nằm, ngồi đúng vị trí quy định trong xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
b) Không mặc đồng phục, không đeo thẻ tên của lái xe theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K2">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 2</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
2. Phạt tiền từ 400.000 đồng đến 600.000 đồng trên mỗi người vượt quá quy định được phép chở của phương tiện nhưng tổng mức phạt tiền tối đa không vượt quá 40.000.000 đồng đối với người điều khiển xe ô tô chở hành khách, ô tô chở người (trừ xe buýt) thực hiện hành vi vi phạm: Chở quá từ 02 người trở lên trên xe đến 9 chỗ, chở quá từ 03 người trở lên trên xe 10 chỗ đến xe 15 chỗ, chở quá từ 04 người trở lên trên xe 16 chỗ đến xe 30 chỗ, chở quá từ 05 người trở lên trên xe trên 30 chỗ, trừ các hành vi vi phạm quy định tại khoản 4 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
a) Không đóng cửa lên xuống khi xe đang chạy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
b) Để người ngồi trên xe khi xe lên, xuống phà, cầu phao hoặc khi xe đang ở trên phà (trừ người già yếu, người bệnh, người khuyết tật);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
c) Không chạy đúng tuyến đường, lịch trình, hành trình vận tải quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
d) Để người mắc võng nằm trên xe hoặc đu bám ở cửa xe, bên ngoài thành xe khi xe đang chạy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
đ) Sắp xếp, chằng buộc hành lý, hàng hóa không bảo đảm an toàn; để rơi hành lý, hàng hóa trên xe xuống đường; để hàng hóa trong khoang chở hành khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
e) Chở hành lý, hàng hóa vượt quá kích thước bao ngoài của xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
g) Vận chuyển hàng có mùi hôi thối trên xe chở hành khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
h) Điều khiển xe vận chuyển hành khách không có nhân viên phục vụ trên xe đối với những xe quy định phải có nhân viên phục vụ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
i) Điều khiển xe taxi không có đồng hồ tính tiền cước (đối với loại xe đăng ký sử dụng đồng hồ tính tiền) hoặc có nhưng không đúng quy định hoặc không sử dụng đồng hồ tính tiền cước theo quy định khi chở khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
k) Điều khiển xe niêm yết hành trình chạy xe không đúng với hành trình đã được cơ quan có thẩm quyền cấp phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
l) Điều khiển xe kinh doanh vận tải hành khách theo tuyến cố định thu tiền vé nhưng không trao vé cho hành khách, thu tiền vé cao hơn quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
m) Điều khiển xe ô tô kinh doanh vận tải không có dây an toàn tại các vị trí ghế ngồi, giường nằm theo quy định (trừ xe buýt nội tỉnh);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
n) Điều khiển xe ô tô kinh doanh vận tải không có hướng dẫn cho hành khách về an toàn giao thông và thoát hiểm khi xảy ra sự cố trên xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
o) Điều khiển xe taxi không sử dụng phần mềm tính tiền (đối với loại xe đăng ký sử dụng phần mềm tính tiền) hoặc sử dụng phần mềm tính tiền không bảo đảm các yêu cầu theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K3-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 3 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
p) Điều khiển xe taxi sử dụng phần mềm tính tiền mà trên xe không có thiết bị để kết nối trực tiếp với hành khách theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
4. Phạt tiền từ 1.000.000 đồng đến 2.000.000 đồng trên mỗi người vượt quá quy định được phép chở của phương tiện nhưng tổng mức phạt tiền tối đa không vượt quá 40.000.000 đồng đối với người điều khiển xe ô tô chở hành khách chạy tuyến có cự ly lớn hơn 300 km thực hiện hành vi vi phạm: Chở quá từ 02 người trở lên trên xe đến 9 chỗ, chở quá từ 03 người trở lên trên xe 10 chỗ đến xe 15 chỗ, chở quá từ 04 người trở lên trên xe 16 chỗ đến xe 30 chỗ, chở quá từ 05 người trở lên trên xe trên 30 chỗ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
a) Để người lên, xuống xe khi xe đang chạy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
b) Sang nhượng hành khách dọc đường cho xe khác mà không được hành khách đồng ý; đe dọa, xúc phạm, tranh giành, lôi kéo hành khách; bắt ép hành khách sử dụng dịch vụ ngoài ý muốn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
c) Xuống khách để trốn tránh sự kiểm tra, kiểm soát của người có thẩm quyền;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
d) Xếp hành lý, hàng hóa trên xe làm lệch xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
đ) Đón, trả hành khách không đúng nơi quy định trên những tuyến đường đã xác định nơi đón, trả khách hoặc dừng đón, trả hành khách quá thời gian quy định, trừ hành vi vi phạm quy định tại điểm a khoản 7 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
e) Đón, trả hành khách tại nơi cấm dừng, cấm đỗ, nơi đường cong tầm nhìn bị che khuất, trừ hành vi vi phạm quy định tại điểm a khoản 7 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
g) Điều khiển xe tham gia kinh doanh vận tải hành khách không gắn thiết bị giám sát hành trình của xe theo quy định, trừ hành vi vi phạm quy định tại điểm đ khoản 6 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
h) Điều khiển xe vận chuyển khách du lịch, xe vận chuyển hành khách theo hợp đồng sử dụng hợp đồng bằng văn bản giấy không có hoặc không mang theo danh sách hành khách theo quy định, chở người không có tên trong danh sách hành khách hoặc vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển học sinh, sinh viên, cán bộ công nhân viên đi học, đi làm việc), không có hoặc không mang theo hợp đồng vận chuyển hoặc có hợp đồng vận chuyển nhưng không đúng theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
i) Vận chuyển hành khách theo tuyến cố định không có hoặc không mang theo Lệnh vận chuyển hoặc có mang theo Lệnh vận chuyển nhưng không ghi đầy đủ thông tin, không có xác nhận của bến xe khách nơi đi, bến xe khách nơi đến theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
k) Đón, trả hành khách không đúng địa điểm đón, trả hành khách được ghi trong hợp đồng, trừ hành vi vi phạm quy định tại điểm a khoản 7 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
l) Vận chuyển khách liên vận quốc tế theo tuyến cố định không có danh sách hành khách theo quy định hoặc chở người không có tên trong danh sách hành khách, trừ hành vi vi phạm quy định tại điểm c khoản 1 Điều 35 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
m) Chở hành lý, hàng hóa vượt quá trọng tải theo thiết kế của xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
n) Điều khiển xe vận chuyển khách du lịch, xe vận chuyển hành khách theo hợp đồng gom khách, bán vé, thu tiền hoặc thực hiện việc xác nhận đặt chỗ cho từng hành khách đi xe; điều khiển xe vận chuyển hành khách theo hợp đồng ấn định hành trình, lịch trình cố định để phục vụ cho nhiều hành khách hoặc nhiều người thuê vận tải khác nhau;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
o) Không sử dụng thẻ nhận dạng lái xe để đăng nhập thông tin theo quy định hoặc sử dụng thẻ nhận dạng lái xe của lái xe khác để đăng nhập thông tin khi điều khiển xe ô tô chở khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
p) Điều khiển xe ô tô kinh doanh vận tải hành khách không lắp camera theo quy định (đối với loại xe có quy định phải lắp camera) hoặc có lắp camera nhưng không ghi, không lưu trữ được hành ảnh trên xe (kể cả người lái xe) trong quá trình xe tham gia giao thông theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K5-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 5 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
q) Điều khiển xe vận chuyển khách du lịch, xe vận chuyển hành khách theo hợp đồng sử dụng hợp đồng điện tử không có thiết bị để truy cập được nội dung của hợp đồng điện tử và danh sách hành khách hoặc có nhưng không cung cấp cho lực lượng chức năng khi có yêu cầu, chở người không có tên trong danh sách hành khách hoặc vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển học sinh, sinh viên, cán bộ công nhân viên đi học, đi làm việc).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
a) Vận chuyển hàng nguy hiểm, hàng độc hại, dễ cháy, dễ nổ hoặc động vật, hàng hóa khác có ảnh hưởng đến sức khỏe của hành khách trên xe chở hành khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
b) Chở người trên mui xe, nóc xe, trong khoang chở hành lý của xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
c) Hành hung hành khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K6-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 6 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
d) Điều khiển xe ô tô quá thời gian quy định tại khoản 1 Điều 65 của Luật giao thông đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K6-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 6 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
đ) Điều khiển xe tham gia kinh doanh vận tải hành khách có gắn thiết bị giám sát hành trình của xe nhưng thiết bị không hoạt động theo quy định hoặc sử dụng biện pháp kỹ thuật, trang thiết bị ngoại vi, các biện pháp khác làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K6-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 6 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
e) Điều khiển xe chở hành khách liên vận quốc tế không có hoặc không gắn ký hiệu phân biệt quốc gia, phù hiệu liên vận theo quy định hoặc có nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
a) Đón, trả hành khách trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
b) Điều khiển xe chở hành khách không có hoặc không gắn phù hiệu (biển hiệu) theo quy định hoặc có nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu (biển hiệu) không do cơ quan có thẩm quyền cấp.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
a) Thực hiện hành vi quy định tại khoản 2, khoản 4 (trường hợp vượt trên 50% đến 100% số người quy định được phép chở của phương tiện); điểm c, điểm d, điểm e khoản 3; điểm a, điểm b, điểm c, điểm d, điểm đ, điểm e, điểm h, điểm i, điểm k, điểm l, điểm m, điểm o, điểm q khoản 5; khoản 6; điểm b khoản 7 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
b) Thực hiện hành vi quy định tại điểm a khoản 7 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
c) Thực hiện hành vi quy định tại khoản 2, khoản 4 Điều này (trường hợp vượt trên 100% số người quy định được phép chở của phương tiện) bị tước quyền sử dụng Giấy phép lái xe từ 03 tháng đến 05 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K8-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 8 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
d) Thực hiện hành vi quy định tại điểm e khoản 6, điểm b khoản 7 Điều này bị tịch thu phù hiệu (biển hiệu) đã hết giá trị sử dụng hoặc không do cơ quan có thẩm quyền cấp.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K9-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 9 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
a) Thực hiện hành vi quy định tại khoản 2, khoản 4 Điều này (trường hợp chở hành khách) buộc phải bố trí phương tiện khác để chở số hành khách vượt quá quy định được phép chở của phương tiện;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D23-K9-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 23 Khoản 9 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 23
b) Thực hiện hành vi quy định tại điểm l khoản 3 Điều này (trường hợp thu tiền vé cao hơn quy định) buộc phải nộp lại số lợi bất hợp pháp có được do thực hiện vi phạm hành chính.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Vận chuyển hàng trên xe phải chằng buộc mà không chằng buộc hoặc có chằng buộc nhưng không chắc chắn, trừ hành vi vi phạm quy định tại điểm c khoản 4 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Điều khiển xe xếp hàng trên nóc buồng lái, xếp hàng làm lệch xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K1-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 1 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Không chốt, đóng cố định cửa sau thùng xe khi xe đang chạy.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 10% đến 30% (trừ xe xi téc chở chất lỏng), trên 20% đến 30% đối với xe xi téc chở chất lỏng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Chở hàng trên nóc thùng xe; chở hàng vượt quá bề rộng thùng xe; chở hàng vượt phía trước, phía sau thùng xe trên 10% chiều dài xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Chở người trên thùng xe trái quy định; để người nằm, ngồi trên mui xe, đu bám bên ngoài xe khi xe đang chạy;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
d) Điều khiển xe tham gia kinh doanh vận tải hàng hóa không có hoặc không mang theo Giấy vận tải (Giấy vận chuyển) bằng văn bản giấy theo quy định hoặc không có thiết bị để truy cập vào được phần mềm thể hiện nội dung của Giấy vận tải (Giấy vận chuyển) theo quy định hoặc có thiết bị để truy cập nhưng không cung cấp cho lực lượng chức năng khi có yêu cầu;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
đ) Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ (bao gồm khối lượng bản thân rơ moóc, sơ mi rơ moóc và khối lượng hàng chuyên chở) của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 10% đến 30%.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Điều khiển xe tham gia kinh doanh vận tải hàng hóa không gắn thiết bị giám sát hành trình của xe theo quy định, trừ hành vi vi phạm quy định tại điểm c khoản 5 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Không sử dụng thẻ nhận dạng lái xe để đăng nhập thông tin theo quy định hoặc sử dụng thẻ nhận dạng lái xe của lái xe khác để đăng nhập thông tin khi điều khiển xe tham gia kinh doanh vận tải hàng hóa;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Điều khiển xe ô tô kinh doanh vận tải hàng hóa không lắp camera theo quy định (đối với loại xe có quy định phải lắp camera) hoặc có lắp camera nhưng không ghi, không lưu trữ được hình ảnh của người lái xe trong quá trình điều khiển xe tham gia giao thông theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Điều khiển xe taxi tải không lắp đồng hồ tính tiền cước hoặc lắp đồng hồ tính tiền cước không đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Chở hàng vượt quá chiều cao xếp hàng cho phép đối với xe ô tô tải (kể cả rơ moóc và sơ mi rơ moóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Chở công-ten-nơ trên xe (kể cả sơ mi rơ moóc) mà không sử dụng thiết bị để định vị chắc chắn công-ten-nơ với xe hoặc có sử dụng thiết bị nhưng công-ten-nơ vẫn bị xê dịch trong quá trình vận chuyển.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 30% đến 50%;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Điều khiển xe quá thời gian quy định tại khoản 1 Điều 65 của Luật Giao thông đường bộ;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Điều khiển xe tham gia kinh doanh vận tải hàng hóa có gắn thiết bị giám sát hành trình của xe nhưng thiết bị không hoạt động theo quy định hoặc sử dụng biện pháp kỹ thuật, trang thiết bị ngoại vi, các biện pháp khác làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
d) Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ (bao gồm khối lượng bản thân rơ moóc, sơ mi rơ moóc và khối lượng hàng chuyên chở) của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 30% đến 50%.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 50% đến 100%;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ (bao gồm khối lượng bản thân rơ moóc, sơ mi rơ moóc và khối lượng hàng chuyên chở) của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 50% đến 100%;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Nhận, trả hàng trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K6-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 6 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
d) Điều khiển xe không có hoặc không gắn phù hiệu theo quy định (đối với loại xe có quy định phải gắn phù hiệu) hoặc có phù hiệu nhưng đã hết giá trị sử dụng hoặc sử dụng phù hiệu không do cơ quan có thẩm quyền cấp.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100% đến 150%;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ (bao gồm khối lượng bản thân rơ moóc, sơ mi rơ moóc và khối lượng hàng chuyên chở) của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100% đến 150%.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Điều khiển xe (kể cả rơ moóc và sơ mi rơ moóc) chở hàng vượt trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 150%;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Điều khiển xe kéo theo rơ moóc, sơ mi rơ moóc mà khối lượng toàn bộ (bao gồm khối lượng bản thân rơ moóc, sơ mi rơ moóc và khối lượng hàng chuyên chở) của rơ moóc, sơ mi rơ moóc vượt khối lượng cho phép kéo theo được ghi trong giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 150%;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Vi phạm quy định tại khoản 1, điểm c khoản 4 Điều này mà gây tai nạn giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K9-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 9 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
a) Thực hiện hành vi quy định tại điểm b, điểm c khoản 2; điểm b khoản 3; điểm b, điểm c khoản 4; khoản 5; điểm a, điểm b, điểm d khoản 6 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K9-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 9 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
b) Thực hiện hành vi quy định tại điểm c khoản 6, khoản 7, điểm c khoản 8 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K9-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 9 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
c) Thực hiện hành vi quy định tại điểm a, điểm b khoản 8 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 03 tháng đến 05 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D24-K9-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 24 Khoản 9 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 24
d) Thực hiện hành vi quy định tại điểm d khoản 6 Điều này bị tịch thu phù hiệu đã hết giá trị sử dụng hoặc không do cơ quan có thẩm quyền cấp.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
a) Chở hàng siêu trường, siêu trọng không có báo hiệu kích thước của hàng theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
b) Không thực hiện đúng quy định trong Giấy phép lưu hành, trừ các hành vi vi phạm quy định tại điểm b, điểm c, điểm d khoản 2 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
a) Chở hàng siêu trường, siêu trọng không có Giấy phép lưu hành hoặc có Giấy phép lưu hành nhưng đã hết giá trị sử dụng hoặc sử dụng Giấy phép lưu hành không do cơ quan có thẩm quyền cấp;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
b) Chở hàng siêu trường, siêu trọng có Giấy phép lưu hành còn giá trị sử dụng nhưng tổng trọng lượng, kích thước bao ngoài của xe (sau khi đã xếp hàng lên xe) vượt quá quy định trong Giấy phép lưu hành;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
c) Chở hàng siêu trường, siêu trọng có Giấy phép lưu hành còn giá trị sử dụng nhưng đi không đúng tuyến đường quy định trong Giấy phép lưu hành;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
d) Chở hàng siêu trường, siêu trọng có Giấy phép lưu hành còn giá trị sử dụng nhưng chở không đúng loại hàng quy định trong Giấy phép lưu hành.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K3-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 3 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
a) Thực hiện hành vi quy định tại khoản 1 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K3-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 3 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
b) Thực hiện hành vi quy định tại khoản 2 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K3-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 3 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
c) Thực hiện hành vi quy định tại điểm a khoản 2 Điều này bị tịch thu Giấy phép lưu hành đã hết giá trị sử dụng hoặc không do cơ quan có thẩm quyền cấp.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D25-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 25 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 25
4. Ngoài việc bị áp dụng hình thức xử phạt, người thực hiện hành vi vi phạm quy định tại khoản 1, khoản 2 Điều này nếu gây hư hại cầu, đường còn bị áp dụng biện pháp khắc phục hậu quả: Buộc khôi phục lại tình trạng ban đầu đã bị thay đổi do vi phạm hành chính gây ra.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D26-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 26 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 26
a) Vận chuyển hàng nguy hiểm mà dừng xe, đỗ xe ở nơi đông người, khu dân cư, công trình quan trọng; không có báo hiệu hàng nguy hiểm theo quy định, trừ các hành vi vi phạm quy định tại khoản 2 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D26-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 26 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 26
b) Vận chuyển các chất gây ô nhiễm môi trường không theo đúng quy định về bảo vệ môi trường, trừ các hành vi vi phạm quy định tại khoản 2 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D26-K2">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 26 Khoản 2</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 26
2. Phạt tiền từ 2.000.000 đồng đến 3.000.000 đồng đối với hành vi vận chuyển hàng nguy hiểm không có giấy phép hoặc có nhưng không thực hiện đúng quy định trong giấy phép, trừ các hành vi vi phạm quy định tại điểm a khoản 6 Điều 23 Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D26-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 26 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 26
3. Ngoài việc bị phạt tiền, người điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 1, khoản 2 Điều này còn bị áp dụng hình thức xử phạt bổ sung tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D26-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 26 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 26
4. Ngoài việc bị áp dụng hình thức xử phạt, người thực hiện hành vi vi phạm quy định tại khoản 1, khoản 2 Điều này nếu gây ô nhiễm môi trường còn bị áp dụng các biện pháp khắc phục hậu quả: Buộc phải thực hiện các biện pháp khắc phục tình trạng ô nhiễm môi trường do vi phạm hành chính gây ra.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D27-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 27 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 27
1. Phạt tiền từ 1.000.000 đồng đến 2.000.000 đồng đối với hành vi điều khiển xe không chạy đúng tuyến, phạm vi, thời gian quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D27-K2">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 27 Khoản 2</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 27
2. Ngoài việc bị phạt tiền, người điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 1 Điều này còn bị áp dụng hình thức xử phạt bổ sung tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K1-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 1 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 10% đến 50% (trừ xe xi téc chở chất lỏng), trên 20% đến 50% đối với xe xi téc chở chất lỏng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K1-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 1 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Xếp hàng hóa lên xe ô tô mà không ký xác nhận việc xếp hàng hóa vào Giấy vận tải theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Không niêm yết hoặc niêm yết không chính xác, đầy đủ tên, số điện thoại của đơn vị kinh doanh vận tải ở phần đầu mặt ngoài hai bên thân hoặc mặt ngoài hai bên cánh cửa xe ô tô chở hành khách theo quy định, trừ hành vi vi phạm quy định tại điểm d khoản 4 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Không niêm yết hoặc niêm yết không chính xác, đầy đủ tên, số điện thoại của đơn vị kinh doanh vận tải hàng hóa, khối lượng bản thân xe, khối lượng hàng hóa cho phép chuyên chở, khối lượng toàn bộ cho phép tham gia giao thông trên cánh cửa xe ô tô tải theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
c) Không niêm yết hoặc niêm yết không chính xác, đầy đủ tên, số điện thoại của đơn vị kinh doanh vận tải hàng hóa, khối lượng bản thân ô tô đầu kéo, khối lượng hàng hóa cho phép chuyên chở, khối lượng toàn bộ cho phép kéo theo trên cánh cửa xe ô tô đầu kéo theo quy định; không niêm yết hoặc niêm yết không chính xác, đầy đủ tên, số điện thoại của đơn vị kinh doanh vận tải hàng hóa, khối lượng hàng hóa cho phép chuyên chở, khối lượng toàn bộ cho phép tham gia giao thông trên rơ moóc, sơ mi rơ moóc theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
d) Không niêm yết hoặc niêm yết không chính xác, đầy đủ tên, số điện thoại của đơn vị kinh doanh taxi tải, chữ taxi tải, tự trọng của xe, trọng tải được phép chở của xe ở mặt ngoài hai bên thành xe hoặc mặt ngoài hai bên cánh cửa buồng lái xe taxi tải theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
đ) Không niêm yết hoặc niêm yết không chính xác, đầy đủ theo quy định trên xe ô tô chở hành khách về: Biển số xe; khối lượng hành lý miễn cước; số điện thoại đường dây nóng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
e) Không đánh số thứ tự ghế ngồi trên xe ô tô chở hành khách theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
g) Sử dụng xe ô tô kinh doanh vận tải hành khách theo tuyến cố định, xe ô tô kinh doanh vận tải hành khách bằng xe buýt không có chỗ ưu tiên cho người khuyết tật, người cao tuổi và phụ nữ mang thai theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K2-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 2 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
h) Sử dụng xe ô tô kinh doanh vận tải hành khách không có hướng dẫn cho hành khách về an toàn giao thông, thoát hiểm khi xảy ra sự cố trên xe theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
3. Phạt tiền từ 2.000.000 đồng đến 3.000.000 đồng đối với cá nhân, từ 4.000.000 đồng đến 6.000.000 đồng đối với tổ chức thực hiện hành vi xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 50% đến 100%.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Không cấp Lệnh vận chuyển, Giấy vận tải (Giấy vận chuyển) cho lái xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Không thực hiện việc đăng ký, niêm yết hoặc niêm yết không chính xác, đầy đủ theo quy định về: Hành trình chạy xe; điểm đầu, điểm cuối của tuyến; giá cước; giá dịch vụ; tiêu chuẩn chất lượng dịch vụ vận tải, dịch vụ hỗ trợ vận tải; trừ các hành vi vi phạm quy định tại điểm đ khoản 2 Điều này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
c) Sử dụng loại xe ô tô chở người có thiết kế từ từ 09 chỗ (kể cả người lái) trở lên làm xe taxi chở hành khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
d) Sử dụng xe taxi chở hành khách không gắn hộp đèn với chữ "TAXI" trên nóc xe và không niêm yết cụm từ "XE TAXI" trên kính phía trước, kính phía sau xe theo quy định hoặc có gắn hộp đèn, có niêm yết cụm từ "XE TAXI" nhưng không cố định, không đúng kích thước, không làm bằng vật liệu phản quang theo quy định; không có hoặc có số điện thoại giao dịch ghi trên xe không đúng với đăng ký của doanh nghiệp (hợp tác xã);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
đ) Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng, xe kinh doanh vận tải khách du lịch không niêm yết cụm từ "XE HỢP ĐỒNG" (đối với xe chở hành khách theo hợp đồng), cụm từ "XE DU LỊCH" (đối với xe chở khách du lịch) trên kính phía trước, kính phía sau xe theo quy định hoặc có niêm yết cụm từ "XE HỢP ĐỒNG", cụm từ "XE DU LỊCH" nhưng không cố định, không đúng kích thước, không làm bằng vật liệu phản quang theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
e) Không cấp "thẻ nhận dạng lái xe" cho lái xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
g) Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không được tập huấn, hướng dẫn về nghiệp vụ vận tải hành khách và an toàn giao thông theo quy định (đối với hình thức kinh doanh vận tải có quy định lái xe, nhân viên phục vụ trên xe phải được tập huấn, hướng dẫn nghiệp vụ);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
h) Sử dụng lái xe, nhân viên phục vụ trên xe để tham gia kinh doanh vận tải bằng xe ô tô mà không có hợp đồng lao động theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
i) Không xây dựng quy trình bảo đảm an toàn giao thông hoặc xây dựng nhưng không đầy đủ các nội dung theo quy định hoặc không thực hiện đúng quy trình bảo đảm an toàn giao thông theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
k) Không bố trí người trực tiếp điều hành hoạt động vận tải hoặc có bố trí nhưng không đáp ứng đủ điều kiện theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
l) Sử dụng phương tiện thuộc sở hữu của thành viên hợp tác xã để kinh doanh vận tải bằng xe ô tô mà không có hợp đồng dịch vụ giữa thành viên với hợp tác xã theo quy định hoặc sử dụng phương tiện không thuộc quyền sử dụng hợp pháp để kinh doanh vận tải bằng xe ô tô;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
m) Không có nơi đỗ xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
n) Bến xe không xác nhận hoặc xác nhận không chính xác, đầy đủ các thông tin trong Lệnh vận chuyển theo quy định hoặc xác nhận vào Lệnh vận chuyển khi xe không có ở bến;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
o) Không thông báo nội dung hợp đồng vận chuyển khách tới Sở Giao thông vận tải trước khi thực hiện hợp đồng vận chuyển hành khách theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
p) Gom khách, bán vé, thu tiền, xác nhận đặt chỗ cho từng hành khách đi xe đối với xe kinh doanh vận tải hành khách theo hợp đồng, xe kinh doanh vận tải khách du lịch; ấn định hành trình, lịch trình cố định để phục vụ cho nhiều hành khách hoặc nhiều người thuê vận tải khác nhau đối với xe kinh doanh vận tải hành khách theo hợp đồng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
q) Sử dụng xe ô tô kinh doanh vận tải hành khách không có dây an toàn tại các vị trí ghế ngồi, giường nằm theo quy định (trừ xe buýt nội tỉnh);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pr">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm r</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
r) Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng, xe kinh doanh vận tải khách du lịch mà xe đó có số chuyến trùng lặp điểm đầu và trùng lặp điểm cuối vượt quá quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Ps">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm s</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
s) Kinh doanh vận tải hành khách theo hợp đồng, kinh doanh vận tải khách du lịch không thực hiện đúng quy định về đón, trả khách tại trụ sở chính, trụ sở chi nhánh, văn phòng đại diện hoặc tại một địa điểm cố định khác do đơn vị kinh doanh vận tải thuê, hợp tác kinh doanh;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K4-Pt">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 4 Điểm t</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
t) Sử dụng xe taxi, xe kinh doanh vận tải hành khách theo hợp đồng, xe kinh doanh vận tải khách du lịch có trên 70% tổng thời gian hoạt động trong 01 tháng (của xe) tại địa bàn của một địa phương (tỉnh, thành phố trực thuộc Trung ương) mà không có phù hiệu do Sở Giao thông vận tải địa phương đó cấp theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K5">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 5</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
5. Phạt tiền từ 4.000.000 đồng đến 5.000.000 đồng đối với cá nhân, từ 8.000.000 đồng đến 10.000.000 đồng đối với tổ chức xếp hàng hóa lên mỗi xe ô tô (kể cả rơ moóc và sơ mi rơ moóc) vượt quá trọng tải (khối lượng hàng chuyên chở) cho phép tham gia giao thông được ghi trong Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe trên 100%.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Tổ chức hoạt động khai thác bến xe, bãi đỗ xe, trạm dừng nghỉ khi chưa được cơ quan có thẩm quyền cho phép theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Để xe ô tô không đủ điều kiện kinh doanh vận tải khách vào bến xe ô tô khách đón khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
c) Không thực hiện việc cung cấp, cập nhật, truyền, lưu trữ, quản lý các thông tin từ thiết bị giám sát hành trình theo quy định; không cung cấp tên đăng nhập, mật khẩu truy cập vào phần mềm xử lý dữ liệu từ thiết bị giám sát hành trình của các xe ô tô thuộc đơn vị cho cơ quan nhà nước có thẩm quyền;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
d) Không thực hiện đúng các nội dung đã đăng ký, niêm yết về: Hành trình chạy xe; điểm đầu, điểm cuối của tuyến; giá cước; giá dịch vụ; tiêu chuẩn chất lượng dịch vụ vận tải, dịch vụ hỗ trợ vận tải;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
đ) Sử dụng phương tiện kinh doanh vận tải không gắn thiết bị giám sát hành trình của xe (đối với hình thức kinh doanh vận tải có quy định phương tiện phải gắn thiết bị) hoặc gắn thiết bị nhưng thiết bị không hoạt động, không đúng quy chuẩn theo quy định hoặc sử dụng biện pháp kỹ thuật, trang thiết bị ngoại vi, các biện pháp khác làm sai lệch dữ liệu của thiết bị giám sát hành trình của xe ô tô;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
e) Sử dụng xe trung chuyển chở hành khách không đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
g) Sử dụng lái xe điều khiển xe khách giường nằm hai tầng chưa đủ số năm kinh nghiệm theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
h) Không có bộ phận quản lý, theo dõi các điều kiện về an toàn giao thông theo quy định hoặc có nhưng bộ phận này không thực hiện đầy đủ các nhiệm vụ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
i) Sử dụng phương tiện kinh doanh vận tải có chất lượng, niên hạn sử dụng không bảo đảm điều kiện của hình thức kinh doanh đã đăng ký;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
k) Không lưu trữ theo quy định các hồ sơ, tài liệu có liên quan trong quá trình quản lý, điều hành hoạt động vận tải của đơn vị;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
l) Không lập hoặc có lập nhưng không cập nhật đầy đủ, chính xác lý lịch phương tiện, lý lịch hành nghề của lái xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
m) Sử dụng xe kinh doanh vận tải hành khách theo hợp đồng, xe kinh doanh vận tải khách du lịch mà trên xe không có hợp đồng vận chuyển (hợp đồng lữ hành), danh sách hành khách kèm theo, thiết bị để truy cập nội dung hợp đồng điện tử và danh sách hành khách theo quy định hoặc có hợp đồng vận chuyển (hợp đồng lữ hành), danh sách hành khách, thiết bị để truy cập nhưng không bảo đảm yêu cầu theo quy định, chở người không có tên trong danh sách hành khách hoặc vận chuyển không đúng đối tượng theo quy định (đối với xe kinh doanh vận tải hành khách theo hợp đồng vận chuyển học sinh, sinh viên, cán bộ công nhân viên đi học, đi làm việc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pn">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm n</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
n) Sử dụng xe taxi chở hành khách không lắp đồng hồ tính tiền (đối với loại xe đăng ký sử dụng đồng hồ tính tiền) hoặc lắp đồng hồ tính tiền không đúng quy định; không có thiết bị in hóa đơn (phiếu thu tiền) được kết nối với đồng hồ tính tiền theo quy định hoặc có nhưng không sử dụng được hoặc in ra phiếu thu tiền nhưng không có đầy đủ các thông tin theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Po">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm o</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
o) Sử dụng xe ô tô kinh doanh vận tải không lắp camera theo quy định (đối với loại xe có quy định phải lắp camera) hoặc có lắp camera nhưng không ghi, không lưu trữ được hành ảnh trên xe, người lái xe trong quá trình xe tham gia giao thông theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pp">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm p</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
p) Không thực hiện việc truyền, lưu trữ hình ảnh từ camera lắp trên xe ô tô về máy chủ của đơn vị, không cung cấp tài khoản truy cập vào máy chủ của đơn vị cho cơ quan nhà nước có thẩm quyền theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K6-Pq">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 6 Điểm q</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
q) Sử dụng xe taxi chở hành khách mà trên xe không có thiết bị để kết nối trực tiếp với hành khách theo quy định (đối với loại xe đăng ký sử dụng phần mềm tính tiền) hoặc sử dụng phần mềm tính tiền không bảo đảm các yêu cầu theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Kinh doanh vận tải bằng xe ô tô mà không có Giấy phép kinh doanh vận tải theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Thực hiện không đúng hình thức kinh doanh đã đăng ký trong Giấy phép kinh doanh vận tải;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
c) Thành lập điểm giao dịch đón, trả khách trái phép (bến dù, bến cóc);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
d) Bến xe không thực hiện quy trình đảm bảo an toàn giao thông cho xe ra, vào bến hoặc thực hiện không đúng, không đầy đủ quy trình đảm bảo an toàn giao thông cho xe ra, vào bến;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
đ) Không tổ chức khám sức khỏe định kỳ cho lái xe theo quy định hoặc có tổ chức khám nhưng không đầy đủ các nội dung theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
e) Không thực hiện việc cung cấp các thông tin trên Lệnh vận chuyển của từng chuyến xe buýt, xe chạy tuyến cố định theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
g) Bến xe khách không áp dụng phần mềm quản lý bến xe, hệ thống camera giám sát theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
h) Vi phạm quy định về kinh doanh, điều kiện kinh doanh vận tải bằng xe ô tô để xảy ra tai nạn giao thông gây hậu quả từ mức nghiêm trọng trở lên;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
i) Sử dụng xe ô tô kinh doanh vận tải để đón, trả khách; nhận, trả hàng trên đường cao tốc;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K7-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 7 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
k) Đơn vị kinh doanh vận tải sử dụng hợp đồng điện tử không có giao diện phần mềm cung cấp cho hành khách hoặc người thuê vận tải theo quy định hoặc có nhưng giao diện không bảo đảm các yêu cầu theo quy định; không thực hiện việc gửi hóa đơn điện tử, lưu trữ dữ liệu hợp đồng điện tử theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Đơn vị sản xuất, lắp ráp, nhập khẩu thiết bị giám sát hành trình của xe ô tô không có nhân sự cho từng vị trí công việc theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Đơn vị sản xuất, lắp ráp, nhập khẩu thiết bị giám sát hành trình của xe ô tô không báo cáo về việc cập nhật, thay đổi Firmware của thiết bị theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
c) Đơn vị cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải không thực hiện đúng quy định về cung cấp phần mềm ứng dụng hỗ trợ kết nối vận tải; không công bố quy trình giải quyết khiếu nại của khách hàng, không có hệ thống lưu trữ các khiếu nại của khách hàng theo quy định.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K9">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 9</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
9. Phạt tiền từ 20.000.000 đồng đến 30.000.000 đồng đối với đơn vị sản xuất, lắp ráp, nhập khẩu thiết bị giám sát hành trình của xe ô tô hoặc đơn vị cung cấp dịch vụ giám sát hành trình của xe ô tô thực hiện hành vi làm sai lệch các thông tin, dữ liệu của thiết bị giám sát hành trình của xe ô tô.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K10-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 10 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Thực hiện hành vi quy định tại điểm h khoản 2; điểm a, điểm b, điểm d, điểm đ, điểm e, điểm g, điểm h, điểm l, điểm o, điểm p, điểm q, điểm r, điểm s, điểm t khoản 4; điểm d, điểm đ, điểm e, điểm g, điểm i, điểm k, điểm l, điểm m, điểm n, điểm o, điểm p, điểm q khoản 6; điểm e, điểm i khoản 7 Điều này bị tước quyền sử dụng phù hiệu (biển hiệu) từ 01 tháng đến 03 tháng (nếu có hoặc đã được cấp) đối với xe vi phạm;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K10-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 10 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Thực hiện hành vi quy định tại điểm i, điểm k khoản 4; điểm h khoản 6; điểm b, điểm h khoản 7 Điều này bị tước quyền sử dụng Giấy phép kinh doanh vận tải từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K10-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 10 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
c) Thực hiện hành vi quy định tại điểm d, điểm đ, điểm i, điểm m khoản 6 Điều này trong trường hợp cá nhân kinh doanh vận tải là người trực tiếp điều khiển phương tiện còn bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K10-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 10 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
d) Thực hiện hành vi quy định tại điểm i khoản 7 Điều này trong trường hợp cá nhân kinh doanh vận tải là người trực tiếp điều khiển phương tiện còn bị tước quyền sử dụng Giấy phép lái xe từ 02 tháng đến 04 tháng;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K10-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 10 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
đ) Thực hiện hành vi quy định tại điểm i khoản 6 Điều này còn bị tịch thu phương tiện (trừ trường hợp xe ô tô từ 10 chỗ ngồi trở lên kinh doanh vận tải hành khách có niên hạn sử dụng vượt quá quy định về điều kiện kinh doanh của hình thức kinh doanh đã đăng ký nhưng chưa quá 20 năm tính từ năm sản xuất, xe ô tô dưới 10 chỗ ngồi kinh doanh vận tải hành khách).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
a) Thực hiện hành vi quy định tại điểm a, điểm b, điểm c, điểm d, điểm đ khoản 2; điểm b khoản 4 Điều này buộc phải đăng ký, niêm yết đầy đủ, chính xác các thông tin theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
b) Thực hiện hành vi quy định tại điểm d, điểm đ khoản 4 Điều này buộc phải gắn hộp đèn với chữ "TAXI" hoặc buộc phải niêm yết cụm từ "XE TAXI", "XE HỢP ĐỒNG", "XE DU LỊCH" theo đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
c) Thực hiện hành vi quy định tại điểm e khoản 4 Điều này buộc phải cấp "thẻ nhận dạng lái xe" cho lái xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
d) Thực hiện hành vi quy định tại điểm g khoản 4, điểm đ khoản 7 Điều này buộc phải tổ chức tập huấn nghiệp vụ hoặc tổ chức khám sức khỏe định kỳ cho lái xe và nhân viên phục vụ trên xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
đ) Thực hiện hành vi quy định tại điểm h khoản 4 Điều này buộc phải ký hợp đồng với lái xe và nhân viên phục vụ trên xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
e) Thực hiện hành vi quy định tại điểm i khoản 4 Điều này buộc phải xây dựng và thực hiện quy trình bảo đảm an toàn giao thông theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
g) Thực hiện hành vi quy định tại điểm k khoản 4 Điều này buộc phải bố trí người trực tiếp điều hành hoạt động vận tải đủ điều kiện theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
h) Thực hiện hành vi quy định tại điểm q khoản 4; điểm đ, điểm n, điểm o khoản 6 Điều này buộc phải lắp đặt camera, dây an toàn, đồng hồ tính tiền cước, thiết bị in hóa đơn, thiết bị giám sát hành trình trên xe theo đúng quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
i) Thực hiện hành vi quy định tại điểm c, điểm p khoản 6 Điều này buộc phải cung cấp, cập nhật, truyền, lưu trữ, quản lý các thông tin từ thiết bị giám sát hành trình, camera lắp trên xe ô tô theo quy định; cung cấp tên đăng nhập, mật khẩu truy cập vào phần mềm xử lý dữ liệu từ thiết bị giám sát hành trình của xe ô tô hoặc máy chủ của đơn vị cho cơ quan có thẩm quyền theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
k) Thực hiện hành vi quy định tại điểm d khoản 6 Điều này (trường hợp thu tiền cước, tiền dịch vụ cao hơn quy định) buộc phải nộp lại số lợi bất hợp pháp có được do thực hiện vi phạm hành chính;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D28-K11-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 28 Khoản 11 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 28
l) Thực hiện hành vi quy định tại điểm k, điểm l khoản 6 Điều này buộc phải lập, cập nhật, lưu trữ đầy đủ, chính xác lý lịch phương tiện, lý lịch hành nghề của lái xe, các hồ sơ, tài liệu có liên quan trong quá trình quản lý, điều hành hoạt động vận tải của đơn vị theo quy định.
Mục 6 CÁC VI PHẠM KHÁC LIÊN QUAN ĐẾN GIAO THÔNG ĐƯỜNG BỘ</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D29-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 29 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 29
1. Phạt tiền từ 1.000.000 đồng đến 2.000.000 đồng đối với cá nhân, từ 2.000.000 đồng đến 4.000.000 đồng đối với tổ chức thực hiện hành vi bán biển số phương tiện giao thông cơ giới đường bộ không phải là biển số do cơ quan nhà nước có thẩm quyền sản xuất hoặc không được cơ quan nhà nước có thẩm quyền cho phép.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D29-K2">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 29 Khoản 2</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 29
2. Phạt tiền từ 3.000.000 đồng đến 5.000.000 đồng đối với cá nhân, từ 6.000.000 đồng đến 10.000.000 đồng đối với tổ chức thực hiện hành vi sản xuất biển số trái phép hoặc sản xuất, lắp ráp trái phép phương tiện giao thông cơ giới đường bộ.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D29-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 29 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 29
3. Ngoài việc bị phạt tiền, cá nhân, tổ chức thực hiện hành vi vi phạm quy định tại khoản 1, khoản 2 Điều này còn bị áp dụng hình thức xử phạt bổ sung tịch thu biển số, phương tiện sản xuất, lắp ráp trái phép.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D29-K4">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 29 Khoản 4</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 29
4. Ngoài việc bị áp dụng hình thức xử phạt, cá nhân, tổ chức thực hiện hành vi quy định tại khoản 1, khoản 2 Điều này còn bị áp dụng biện pháp khắc phục hậu quả: Buộc nộp lại số lợi bất hợp pháp có được do thực hiện vi phạm hành chính.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K1">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 1</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
1. Phạt tiền từ 100.000 đồng đến 200.000 đồng đối với cá nhân, từ 200.000 đồng đến 400.000 đồng đối với tổ chức là chủ xe mô tô, xe gắn máy và các loại xe tương tự xe mô tô thực hiện hành vi tự ý thay đổi nhãn hiệu, màu sơn của xe không đúng với Giấy đăng ký xe.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K2-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 2 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
a) Lắp kính chắn gió, kính cửa của xe không phải là loại kính an toàn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K2-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 2 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
b) Tự ý thay đổi màu sơn của xe không đúng với màu sơn ghi trong Giấy đăng ký xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K2-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 2 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
c) Không làm thủ tục khai báo với cơ quan đăng ký xe theo quy định trước khi cải tạo xe (đối với loại xe có quy định phải làm thủ tục khai báo).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K3">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 3</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
3. Phạt tiền từ 400.000 đồng đến 600.000 đồng trên mỗi người vượt quá quy định được phép chở của phương tiện nhưng tổng mức phạt tiền tối đa không vượt quá 40.000.000 đồng đối với chủ phương tiện là cá nhân, từ 800.000 đồng đến 1.200.000 đồng trên mỗi người vượt quá quy định được phép chở của phương tiện nhưng tổng mức phạt tiền tối đa không vượt quá 80.000.000 đồng đối với chủ phương tiện là tổ chức giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 2 Điều 23 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 2 Điều 23 Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K4-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 4 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
a) Không làm thủ tục đăng ký sang tên xe (để chuyển tên chủ xe trong Giấy đăng ký xe sang tên của mình) theo quy định khi mua, được cho, được tặng, được phân bổ, được điều chuyển, được thừa kế tài sản là xe mô tô, xe gắn máy, các loại xe tương tự xe mô tô;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K4-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 4 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
b) Không làm thủ tục đổi lại Giấy đăng ký xe theo quy định khi thay đổi địa chỉ của chủ xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K4-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 4 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
c) Không thực hiện đúng quy định về biển số, trừ các hành vi vi phạm quy định tại điểm i khoản 5 Điều này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
a) Tự ý cắt, hàn, đục lại số khung, số máy; đưa phương tiện đã bị cắt, hàn, đục lại số khung, số máy trái quy định tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
b) Tẩy xóa, sửa chữa hoặc giả mạo hồ sơ đăng ký xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
c) Tự ý thay đổi khung, máy, hình dáng, kích thước, đặc tính của xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
d) Khai báo không đúng sự thật hoặc sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số, Giấy đăng ký xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
đ) Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 58 của Luật Giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có Giấy phép lái xe nhưng đã hết hạn sử dụng hoặc đang trong thời gian bị tước quyền sử dụng);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
e) Không chấp hành việc thu hồi Giấy đăng ký xe, biển số xe theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
g) Đưa phương tiện không có Giấy đăng ký xe tham gia giao thông hoặc có nhưng đã hết hạn sử dụng; đưa phương tiện có Giấy chứng nhận đăng ký xe tạm thời tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
h) Đưa phương tiện có Giấy đăng ký xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông; đưa phương tiện có Giấy đăng ký xe nhưng không đúng với số khung số máy của xe tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
i) Lắp đặt, sử dụng thiết bị thay đổi biển số trên xe trái quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K5-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 5 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
k) Đưa phương tiện không gắn biển số (đối với loại xe có quy định phải gắn biển số) tham gia giao thông; đưa phương tiện gắn biển số không đúng với Giấy đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp tham gia giao thông.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K6">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 6</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
6. Phạt tiền từ 1.000.000 đồng đến 2.000.000 đồng trên mỗi người vượt quá quy định được phép chở của phương tiện nhưng tổng mức phạt tiền tối đa không vượt quá 40.000.000 đồng đối với chủ phương tiện là cá nhân, từ 2.000.000 đồng đến 4.000.000 đồng trên mỗi người vượt quá quy định được phép chở của phương tiện nhưng tổng mức phạt tiền tối đa không vượt quá 80.000.000 đồng đối với chủ phương tiện là tổ chức giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 23 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 23 Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
a) Tự ý cắt, hàn, đục lại số khung, số máy; đưa phương tiện đã bị cắt, hàn, đục lại số khung, số máy trái quy định tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
b) Tẩy xóa hoặc sửa chữa hồ sơ đăng ký xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
c) Không chấp hành việc thu hồi Giấy đăng ký xe; biển số xe; Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường phương tiện giao thông cơ giới đường bộ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
d) Không làm thủ tục đổi lại Giấy đăng ký xe theo quy định khi xe đã được cải tạo hoặc khi thay đổi địa chỉ của chủ xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
đ) Không thực hiện đúng quy định về biển số, quy định về kẻ chữ trên thành xe và cửa xe, trừ các hành vi vi phạm quy định tại: điểm g khoản 8 Điều này và các hành vi vi phạm quy định tại điểm a, điểm b, điểm c, điểm d, điểm đ khoản 2 Điều 28; điểm b khoản 3 Điều 37 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
e) Khai báo không đúng sự thật hoặc sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số, Giấy đăng ký xe, Giấy chứng nhận kiểm định an toàn kỹ thuật và bảo vệ môi trường;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
g) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm e khoản 3, điểm m khoản 5 Điều 23 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm e khoản 3, điểm m khoản 5 Điều 23 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
h) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm đ khoản 2 Điều 24 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm đ khoản 2 Điều 24 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
i) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b khoản 2 Điều 24 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b khoản 2 Điều 24 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pk">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm k</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
k) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 2 Điều 33 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 2 Điều 33 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pl">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm l</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
l) Không làm thủ tục đăng ký sang tên xe (để chuyển tên chủ xe trong Giấy đăng ký xe sang tên của mình) theo quy định khi mua, được cho, được tặng, được phân bổ, được điều chuyển, được thừa kế tài sản là xe ô tô, máy kéo, xe máy chuyên dùng, các loại xe tương tự xe ô tô;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K7-Pm">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 7 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
m) Đưa phương tiện không có Giấy đăng ký xe tham gia giao thông hoặc có nhưng đã hết hạn sử dụng; đưa phương tiện có Giấy chứng nhận đăng ký xe tạm thời tham gia giao thông quá thời hạn, tuyến đường, phạm vi cho phép.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
a) Thuê, mượn linh kiện, phụ kiện của xe ô tô khi kiểm định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
b) Đưa xe cơ giới, xe máy chuyên dùng có Giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) nhưng đã hết hạn sử dụng dưới 01 tháng (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
c) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b khoản 4 Điều 24 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b khoản 4 Điều 24 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
d) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm d khoản 6 Điều 23; điểm b khoản 5 Điều 24 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm d khoản 6 Điều 23; điểm b khoản 5 Điều 24 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
đ) Đưa phương tiện quá niên hạn sử dụng tham gia giao thông, trừ hành vi vi phạm quy định tại điểm i khoản 6 Điều 28 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
e) Đưa phương tiện có Giấy đăng ký xe, Giấy chứng nhận, tem kiểm định an toàn kỹ thuật và bảo vệ môi trường của xe nhưng không do cơ quan có thẩm quyền cấp hoặc bị tẩy xóa tham gia giao thông; đưa phương tiện có Giấy đăng ký xe nhưng không đúng với số khung số máy của xe (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
g) Đưa phương tiện không gắn biển số (đối với loại xe có quy định phải gắn biển số) tham gia giao thông; đưa phương tiện gắn biển số không đúng với Giấy đăng ký xe hoặc gắn biển số không do cơ quan có thẩm quyền cấp (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
h) Giao xe hoặc để cho người không đủ điều kiện theo quy định tại khoản 1 Điều 58 (đối với xe ô tô, máy kéo và các loại xe tương tự xe ô tô), khoản 1 Điều 62 (đối với xe máy chuyên dùng) của Luật Giao thông đường bộ điều khiển xe tham gia giao thông (bao gồm cả trường hợp người điều khiển phương tiện có Giấy phép lái xe, chứng chỉ bồi dưỡng kiến thức pháp luật về giao thông đường bộ nhưng đã hết hạn sử dụng hoặc đang trong thời gian bị tước quyền sử dụng);</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K8-Pi">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 8 Điểm i</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
i) Lắp đặt, sử dụng thiết bị thay đổi biển số trên xe trái quy định (kể cả rơ moóc và sơ mi rơ moóc).</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Pa">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm a</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
a) Tự ý thay đổi tổng thành khung, tổng thành máy (động cơ), hệ thống phanh, hệ thống truyền động (truyền lực), hệ thống chuyển động hoặc tự ý cải tạo kết cấu, hình dáng, kích thước của xe không đúng thiết kế của nhà sản xuất hoặc thiết kế đã đăng ký với cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt; tự ý thay đổi tính năng sử dụng của xe;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Pb">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm b</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
b) Cải tạo các xe ô tô khác thành xe ô tô chở khách;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Pc">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm c</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
c) Đưa xe cơ giới, xe máy chuyên dùng không có Giấy chứng nhận hoặc tem kiểm định an toàn kỹ thuật và bảo vệ môi trường (đối với loại xe có quy định phải kiểm định) hoặc có nhưng đã hết hạn sử dụng từ 01 tháng trở lên (kể cả rơ moóc và sơ mi rơ moóc) tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
d) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 24 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm a, điểm d khoản 5 Điều 24 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm đ</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
đ) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 3 Điều 33 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 3 Điều 33 Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Pe">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm e</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
e) Đưa xe ô tô tải có kích thước thùng xe không đúng thiết kế của nhà sản xuất hoặc thiết kế đã đăng ký với cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Pg">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm g</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
g) Đưa xe ô tô kinh doanh vận tải hành khách lắp thêm hoặc tháo bớt ghế, giường nằm hoặc có kích thước khoang chở hành lý (hầm xe) không đúng thiết kế của nhà sản xuất hoặc thiết kế đã đăng ký với cơ quan đăng ký xe hoặc thiết kế cải tạo đã được cơ quan có thẩm quyền phê duyệt tham gia giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND100-D30-K9-Ph">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 100/2019, Điều 30 Khoản 9 Điểm h</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 30
h) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b khoản 7 Điều 23; điểm d khoản 6 Điều 24 Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại điểm b khoản 7 Điều 23; điểm d khoản 6 Điều 24 Nghị định này.</legalExcerpt>
