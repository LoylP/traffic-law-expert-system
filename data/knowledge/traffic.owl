<owl:NamedIndividual rdf:about="#VIOLATION_V0149">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D8-K4-Pb"/>
  <appliesToVehicle rdf:resource="#VEH_SPECIAL_individual"/>
  <rdfs:label xml:lang="vi">ND168-D8-K4-Pb: Chạy xe trong hầm đường bộ không sử dụng đèn chiếu sáng gần;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000000</fineMin>
