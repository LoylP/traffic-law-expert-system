  <appliesToVehicle rdf:resource="#VEH_SPECIAL_individual"/>
  <rdfs:label xml:lang="vi">ND168-D8-K3-Pc: Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000000</fineMax>
  <pointsDeducted rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</pointsDeducted>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
c) Không sử dụng hoặc sử dụng không đủ đèn chiếu sáng trong thời gian từ 18 giờ ngày hôm trước đến 06 giờ ngày hôm sau hoặc khi có sương mù, khói, bụi, trời mưa, thời tiết xấu làm hạn chế tầm nhìn;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VIOLATION_V0146">
