  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 123/2021, Điều 2 Khoản 26 Điểm m</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
m) Sửa đổi điểm p khoản 5 Điều 74 như sau:
"p) Khoản 1; điểm b, điểm c khoản 2; điểm c khoản 3; khoản 4; khoản 5 Điều 35;".</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND123-D2-K27">
