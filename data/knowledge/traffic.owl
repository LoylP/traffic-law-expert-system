d) Áp dụng biện pháp khắc phục hậu quả quy định tại các điểm a, điểm b và điểm c khoản 1 Điều 4 Nghị định này.</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND123-D2-K2-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 123/2021, Điều 2 Khoản 2 Điểm d</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
d) Tịch thu tang vật, phương tiện được sử dụng để vi phạm hành chính;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND123-D2-K2-Pđ">
  <rdf:type rdf:resource="#LegalProvision"/>
  <rdfs:label xml:lang="vi">NĐ 123/2021, Điều 2 Khoản 2 Điểm đ</rdfs:label>
