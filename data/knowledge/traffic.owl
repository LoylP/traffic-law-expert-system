<owl:NamedIndividual rdf:about="#VIOLATION_V0089">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D7-K2-Pe"/>
  <appliesToVehicle rdf:resource="#VEH_MOTORBIKE_individual"/>
  <rdfs:label xml:lang="vi">ND168-D7-K2-Pe: Dừng xe, đỗ xe trên điểm đón, trả khách, nơi đường bộ giao nhau, trên phần đường dành cho người đi bộ qua đường; dừng xe nơi có biển “Cấm dừng xe và đỗ xe”; đỗ xe tại nơi có biển “Cấm đỗ xe” hoặc biển “Cấm dừng xe và đỗ xe”; không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt; dừng xe, đỗ xe trong phạm vi hành lang an toàn giao thông đường sắt;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">600000</fineMax>
  <pointsDeducted rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</pointsDeducted>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
e) Dừng xe, đỗ xe trên điểm đón, trả khách, nơi đường bộ giao nhau, trên phần đường dành cho người đi bộ qua đường; dừng xe nơi có biển "Cấm dừng xe và đỗ xe"; đỗ xe tại nơi có biển "Cấm đỗ xe" hoặc biển "Cấm dừng xe và đỗ xe"; không tuân thủ các quy định về dừng xe, đỗ xe tại nơi đường bộ giao nhau cùng mức với đường sắt; dừng xe, đỗ xe trong phạm vi hành lang an toàn giao thông đường sắt;</legalExcerpt>
</owl:NamedIndividual>

