<owl:NamedIndividual rdf:about="#VIOLATION_V0113">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D7-K6-Pa"/>
  <appliesToVehicle rdf:resource="#VEH_MOTORBIKE_individual"/>
  <instanceOfAct rdf:resource="#ACT_ALCOHOL"/>
  <requiresContext rdf:resource="#BAC_L1"/>
  <rdfs:label xml:lang="vi">ND168-D7-K6-Pa: Điều khiển xe trên đường mà trong máu hoặc hơi thở có nồng độ cồn nhưng chưa vượt quá 50 miligam/100 mililít máu hoặc chưa vượt quá 0,25 miligam/1 lít khí thở;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2000000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000000</fineMax>
  <pointsDeducted rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</pointsDeducted>
