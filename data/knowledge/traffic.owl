<owl:NamedIndividual rdf:about="#VIOLATION_V0583">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D39-K3-Pd"/>
  <appliesToVehicle rdf:resource="#VEH_ANY_individual"/>
  <rdfs:label xml:lang="vi">ND168-D39-K3-Pd: Cơ sở đào tạo lái xe tuyển sinh học viên không đủ điều kiện trình độ văn hóa, thời gian lái xe an toàn tương ứng với từng hạng đào tạo; tuyển sinh học viên không đủ hồ sơ theo quy định;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5000000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10000000</fineMax>
