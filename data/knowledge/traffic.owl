  <rdfs:label xml:lang="vi">NĐ 123/2021, Điều 2 Khoản 27</rdfs:label>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 2
27. Sửa đổi Điều 75 như sau:
"Điều 75. Thẩm quyền xử phạt của Chủ tịch Ủy ban nhân dân các cấp</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ND123-D2-K1-Pd">
  <rdf:type rdf:resource="#LegalProvision"/>
