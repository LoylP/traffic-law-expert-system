<owl:NamedIndividual rdf:about="#VIOLATION_V0493">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D32-K8-Pc"/>
  <appliesToVehicle rdf:resource="#VEH_MOTORBIKE_individual"/>
  <rdfs:label xml:lang="vi">ND168-D32-K8-Pc: Khai báo không đúng sự thật hoặc sử dụng các giấy tờ, tài liệu giả để được cấp lại biển số xe, chứng nhận đăng ký xe nhưng chưa đến mức bị truy cứu trách nhiệm hình sự;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4000000</fineMin>
