<owl:NamedIndividual rdf:about="#VIOLATION_V0143">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D8-K3-Pa"/>
  <appliesToVehicle rdf:resource="#VEH_SPECIAL_individual"/>
  <rdfs:label xml:lang="vi">ND168-D8-K3-Pa: Chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000000</fineMax>
  <pointsDeducted rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</pointsDeducted>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
a) Chạy quá tốc độ quy định từ 05 km/h đến dưới 10 km/h;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VIOLATION_V0144">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D8-K3-Pb"/>
  <appliesToVehicle rdf:resource="#VEH_SPECIAL_individual"/>
  <rdfs:label xml:lang="vi">ND168-D8-K3-Pb: Sử dụng còi, rú ga liên tục; sử dụng còi hơi, sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000000</fineMax>
  <pointsDeducted rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</pointsDeducted>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
b) Sử dụng còi, rú ga liên tục; sử dụng còi hơi, sử dụng đèn chiếu xa khi gặp người đi bộ qua đường hoặc khi đi trên đoạn đường qua khu dân cư có hệ thống chiếu sáng đang hoạt động hoặc khi gặp xe đi ngược chiều (trừ trường hợp dải phân cách có khả năng chống chói) hoặc khi chuyển hướng xe tại nơi đường giao nhau, trừ các xe ưu tiên đang đi làm nhiệm vụ theo quy định;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VIOLATION_V0145">
