<owl:NamedIndividual rdf:about="#VIOLATION_V0079">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D7-K1-Pe"/>
  <appliesToVehicle rdf:resource="#VEH_MOTORBIKE_individual"/>
  <rdfs:label xml:lang="vi">ND168-D7-K1-Pe: Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước hoặc chuyển làn đường không đúng quy định “mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề”;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400000</fineMax>
  <pointsDeducted rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</pointsDeducted>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 7
e) Chuyển làn đường không đúng nơi cho phép hoặc không có tín hiệu báo trước hoặc chuyển làn đường không đúng quy định "mỗi lần chuyển làn đường chỉ được phép chuyển sang một làn đường liền kề";</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VIOLATION_V0080">
  <rdf:type rdf:resource="#Violation"/>
