  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 8
b) Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VIOLATION_V0171">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D8-K7-Pc"/>
  <appliesToVehicle rdf:resource="#VEH_SPECIAL_individual"/>
  <rdfs:label xml:lang="vi">ND168-D8-K7-Pc: Không chấp hành hiệu lệnh của đèn tín hiệu giao thông;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6000000</fineMin>
