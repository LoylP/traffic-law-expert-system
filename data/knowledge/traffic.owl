<owl:NamedIndividual rdf:about="#VIOLATION_V0501">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D32-K9-Pc"/>
  <appliesToVehicle rdf:resource="#VEH_ANY_individual"/>
  <rdfs:label xml:lang="vi">ND168-D32-K9-Pc: Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 21 của Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 21 của Nghị định này;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4000000</fineMin>
  <fineMax rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6000000</fineMax>
  <pointsDeducted rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</pointsDeducted>
  <legalExcerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 32
c) Giao phương tiện hoặc để cho người làm công, người đại diện điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 21 của Nghị định này hoặc trực tiếp điều khiển phương tiện thực hiện hành vi vi phạm quy định tại khoản 4 Điều 21 của Nghị định này;</legalExcerpt>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#VIOLATION_V0502">
