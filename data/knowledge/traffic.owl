  <rdfs:label xml:lang="vi">ND168-D26-K7-Pb: Không thực hiện đúng nội dung thông tin đã niêm yết trên xe theo quy định;</rdfs:label>
  <fineMin rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5000000</fineMin>
