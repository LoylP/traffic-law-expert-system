<owl:NamedIndividual rdf:about="#VIOLATION_V0170">
  <rdf:type rdf:resource="#Violation"/>
  <basedOn rdf:resource="#ND168-D8-K7-Pb"/>
  <appliesToVehicle rdf:resource="#VEH_SPECIAL_individual"/>
  <rdfs:label xml:lang="vi">ND168-D8-K7-Pb: Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;</rdfs:label>
