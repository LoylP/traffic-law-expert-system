# LLM (all calls go through src/reasoning/llm_client.py)
# ollama (default, native API) | openai_compatible (e.g. LM Studio) | gemini
LLM_PROVIDER=ollama
# Ollama: http://localhost:11434/v1 ; LM Studio: http://localhost:1234/v1
# API in Docker + Ollama on the host: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# On macOS keep the GGUF tag (the plain qwen3.5:4b tag has no structured output)
LLM_MODEL=qwen3.5:4b-q4_K_M
LLM_SEED=42
LLM_DISABLE_THINKING=true
# Seconds per request
LLM_TIMEOUT=120
# Optional response cache directory (empty = off), e.g. .llm_cache
LLM_CACHE_DIR=
# Only for LLM_PROVIDER=gemini (then set LLM_MODEL to a Gemini model)
GOOGLE_API_KEY=

# Optional OntologyGrounder thresholds
# GROUND_THRESHOLD=0.75
# GROUND_MIN_COSINE=0.84
